#!/bin/sh
# The Chumby's UI in the simulator (the chumby-sim image: the device's own
# root filesystem, ARM, run through QEMU user emulation): what
# chumby-session.service does on the device, as a window on the host's
# Wayland desktop (or headless: CHUMBY_SIM_HEADLESS=1, for tests).
set -e

rm -rf /run/chumby
install -d -o chumby -g chumby -m 0775 /run/chumby /run/chumby/audio
install -d -o chumby -g chumby /var/lib/chumby
mkdir -p /var/apps /run/systemd/timesync
# The clock is the host's, and right: as if NTP had synced (alarms on, no
# "no network" mark).
touch /run/systemd/timesync/synchronized

export XDG_RUNTIME_DIR=/run/chumby WLR_RENDERER=pixman
if [ -n "${CHUMBY_SIM_HEADLESS:-}" ]; then
	export WLR_BACKENDS=headless WLR_HEADLESS_OUTPUTS=1
else
	# chumby-wm is a client of the host's compositor (its socket is
	# mounted at /run/host/wayland-0), at 3x: 960x720.
	export WLR_BACKENDS=wayland WAYLAND_DISPLAY=/run/host/wayland-0
	export CHUMBY_WM_SIZE="${CHUMBY_SIM_SIZE:-960x720}"
fi
exec /usr/bin/chumby-wm -s /usr/bin/chumby-shell
