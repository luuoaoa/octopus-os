#cloud-config
hostname: chumby
# Local time for the clock and alarms: a tz database name, e.g.
# Europe/London, America/New_York, Asia/Tokyo. The clock is set over the
# network (NTP) once WiFi is up.
timezone: America/Los_Angeles
# Optional: where the Chumby is, "<latitude>,<longitude>", to name FM
# stations and fetch their logos. If unset it's guessed from the IP address.
#location: 37.77,-122.42
# The SSH server is off until turned on in Settings (Network), which also
# makes a root password and shows it. Or uncomment this to have it on from
# the first boot (log in with the root password below, or keys in
# authorized_keys on this partition). Settings' choice, once made, wins.
#ssh: true
# false = key-only SSH logins.
#ssh_pwauth: false
# Uncomment to replace the default root password ("root").
# Generate with: mkpasswd -m sha-512   (or: openssl passwd -6)
#passwd: $6$salt$hash
