From: falconwing bring-up
Subject: [PATCH] drm: mxsfb: restart the scanout after a FIFO underflow

On the Chumby One (i.MX23) the picture came up split after boot: the
top left corner in the middle of the panel, wrapped around. LCDIF
CTRL1 showed UNDERFLOW_IRQ set, RECOVER_ON_UNDERFLOW was set too, and
the shift stayed until the next modeset, which cleared it.

Enable the underflow interrupt while scanning out and, when it fires,
redo from a work item what a modeset does (under the modeset locks,
only if the CRTC is active): stop, soft-reset the block, program its
formats and timings again, restore the vblank interrupt, start again
from the current buffer. Merely stopping and restarting the controller
wasn't always enough.

Restarts are at most once a second; an underflow that comes sooner is
put off until then, not dropped: boot brings them in bursts, and a
dropped one left the picture split for good.

---
--- a/drivers/gpu/drm/mxsfb/mxsfb_drv.c	2026-04-11 05:29:58.000000000 -0700
+++ b/drivers/gpu/drm/mxsfb/mxsfb_drv.c	2026-10-11 21:40:44.007903542 -0700
@@ -172,6 +172,18 @@
 
 	writel(CTRL1_CUR_FRAME_DONE_IRQ, mxsfb->base + LCDC_CTRL1 + REG_CLR);
 
+	if (reg & CTRL1_UNDERFLOW_IRQ) {
+		writel(CTRL1_UNDERFLOW_IRQ, mxsfb->base + LCDC_CTRL1 + REG_CLR);
+		/*
+		 * At most once a second, should it keep underflowing; one
+		 * that comes sooner is put off, not dropped, or the picture
+		 * would stay split.
+		 */
+		schedule_delayed_work(&mxsfb->underflow_work,
+				      time_after(mxsfb->underflow_next, jiffies) ?
+				      mxsfb->underflow_next - jiffies : 0);
+	}
+
 	return IRQ_HANDLED;
 }
 
@@ -220,6 +232,8 @@
 	mxsfb->drm = drm;
 	drm->dev_private = mxsfb;
 	mxsfb->devdata = devdata;
+	INIT_DELAYED_WORK(&mxsfb->underflow_work, mxsfb_underflow_work);
+	mxsfb->underflow_next = jiffies;
 
 	mxsfb->base = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(mxsfb->base))
@@ -315,6 +329,7 @@
 	pm_runtime_get_sync(drm->dev);
 	mxsfb_irq_uninstall(drm);
 	pm_runtime_put_sync(drm->dev);
+	cancel_delayed_work_sync(&((struct mxsfb_drm_private *)drm->dev_private)->underflow_work);
 
 	drm->dev_private = NULL;
 
--- a/drivers/gpu/drm/mxsfb/mxsfb_drv.h	2026-04-11 05:29:58.000000000 -0700
+++ b/drivers/gpu/drm/mxsfb/mxsfb_drv.h	2026-10-11 21:40:44.007943838 -0700
@@ -12,6 +12,7 @@
 #include <drm/drm_device.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_plane.h>
+#include <linux/workqueue.h>
 
 struct clk;
 
@@ -47,6 +48,12 @@
 	struct drm_bridge		*bridge;
 
 	bool				crc_active;
+
+	/* Restart the scanout after a FIFO underflow (see mxsfb_kms.c). */
+	struct delayed_work		underflow_work;
+	unsigned long			underflow_next;	/* jiffies */
+	u32				bus_format;	/* of the last modeset */
+	u32				bus_flags;
 };
 
 static inline struct mxsfb_drm_private *
@@ -59,5 +66,6 @@
 void mxsfb_disable_axi_clk(struct mxsfb_drm_private *mxsfb);
 
 int mxsfb_kms_init(struct mxsfb_drm_private *mxsfb);
+void mxsfb_underflow_work(struct work_struct *work);
 
 #endif /* __MXSFB_DRV_H__ */
--- a/drivers/gpu/drm/mxsfb/mxsfb_kms.c	2026-04-11 05:29:58.000000000 -0700
+++ b/drivers/gpu/drm/mxsfb/mxsfb_kms.c	2026-10-11 21:41:30.114273694 -0700
@@ -19,6 +19,7 @@
 #include <drm/drm_atomic_helper.h>
 #include <drm/drm_bridge.h>
 #include <drm/drm_crtc.h>
+#include <drm/drm_drv.h>
 #include <drm/drm_encoder.h>
 #include <drm/drm_fb_dma_helper.h>
 #include <drm/drm_fourcc.h>
@@ -202,6 +203,10 @@
 	reg |= CTRL1_RECOVER_ON_UNDERFLOW;
 	writel(reg, mxsfb->base + LCDC_CTRL1);
 
+	/* ... and restart it ourselves if that isn't enough (i.MX23). */
+	writel(CTRL1_UNDERFLOW_IRQ, mxsfb->base + LCDC_CTRL1 + REG_CLR);
+	writel(CTRL1_UNDERFLOW_IRQ_EN, mxsfb->base + LCDC_CTRL1 + REG_SET);
+
 	writel(CTRL_RUN, mxsfb->base + LCDC_CTRL + REG_SET);
 }
 
@@ -209,6 +214,8 @@
 {
 	u32 reg;
 
+	writel(CTRL1_UNDERFLOW_IRQ_EN, mxsfb->base + LCDC_CTRL1 + REG_CLR);
+
 	/*
 	 * Even if we disable the controller here, it will still continue
 	 * until its FIFOs are running out of data
@@ -307,6 +314,50 @@
 	clk_set_rate(mxsfb->clk, m->crtc_clock * 1000);
 
 	mxsfb_set_mode(mxsfb, bus_flags);
+
+	mxsfb->bus_format = bus_format;
+	mxsfb->bus_flags = bus_flags;
+}
+
+/*
+ * On the i.MX23 a FIFO underflow (the system bus busy for too long, e.g.
+ * during boot) leaves the image permanently shifted and wrapped around,
+ * RECOVER_ON_UNDERFLOW notwithstanding. Unlike the case described above,
+ * UNDERFLOW_IRQ does assert there, so redo what a modeset does when it
+ * does, as only a modeset has been seen to clear the shift: stop, reset
+ * the block, program it again and start from the current buffer.
+ */
+void mxsfb_underflow_work(struct work_struct *work)
+{
+	struct mxsfb_drm_private *mxsfb =
+		container_of(to_delayed_work(work), struct mxsfb_drm_private,
+			     underflow_work);
+	struct drm_crtc *crtc = &mxsfb->crtc;
+	struct drm_modeset_acquire_ctx ctx;
+	u32 addr, vblank;
+	int ret;
+
+	DRM_MODESET_LOCK_ALL_BEGIN(mxsfb->drm, ctx, 0, ret);
+	if (crtc->state && crtc->state->active &&
+	    crtc->primary->state && crtc->primary->state->fb) {
+		addr = readl(mxsfb->base + mxsfb->devdata->next_buf);
+		vblank = readl(mxsfb->base + LCDC_CTRL1) &
+			 CTRL1_CUR_FRAME_DONE_IRQ_EN;
+		mxsfb_disable_controller(mxsfb);
+		if (!mxsfb_reset_block(mxsfb)) {
+			mxsfb_set_formats(mxsfb, mxsfb->bus_format);
+			mxsfb_set_mode(mxsfb, mxsfb->bus_flags);
+			/* The reset cleared the vblank interrupt too. */
+			writel(vblank, mxsfb->base + LCDC_CTRL1 + REG_SET);
+		}
+		writel(addr, mxsfb->base + mxsfb->devdata->cur_buf);
+		writel(addr, mxsfb->base + mxsfb->devdata->next_buf);
+		mxsfb_enable_controller(mxsfb);
+		dev_info_ratelimited(mxsfb->drm->dev,
+				     "FIFO underflow: scanout restarted\n");
+	}
+	mxsfb->underflow_next = jiffies + HZ;
+	DRM_MODESET_LOCK_ALL_END(mxsfb->drm, ctx, ret);
 }
 
 static int mxsfb_crtc_atomic_check(struct drm_crtc *crtc,
--- a/drivers/gpu/drm/mxsfb/mxsfb_regs.h	2026-04-11 05:29:58.000000000 -0700
+++ b/drivers/gpu/drm/mxsfb/mxsfb_regs.h	2026-10-11 21:40:44.008038466 -0700
@@ -60,7 +60,9 @@
 #define CTRL1_FIFO_CLEAR		BIT(21)
 #define CTRL1_SET_BYTE_PACKAGING(x)	(((x) & 0xf) << 16)
 #define CTRL1_GET_BYTE_PACKAGING(x)	(((x) >> 16) & 0xf)
+#define CTRL1_UNDERFLOW_IRQ_EN		BIT(14)
 #define CTRL1_CUR_FRAME_DONE_IRQ_EN	BIT(13)
+#define CTRL1_UNDERFLOW_IRQ		BIT(10)
 #define CTRL1_CUR_FRAME_DONE_IRQ	BIT(9)
 
 #define CTRL2_SET_OUTSTANDING_REQS_1	0
