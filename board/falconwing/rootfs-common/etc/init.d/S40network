#!/bin/sh
#
# Bring up networking: loopback, wifi (wlan0 via wpa_supplicant) and any
# USB ethernet adapter (eth0), each with a backgrounded udhcpc.
#
# The internal wifi is a USB device; the driver is autoloaded by mdev
# after S03usb, so wait a bit for wlan0 to show up.

WPA_CONF=/etc/wpa_supplicant.conf
WAIT=20

wait_iface() {
	i=0
	while [ $i -lt $1 ]; do
		[ -e /sys/class/net/$2 ] && return 0
		sleep 1
		i=$((i + 1))
	done
	return 1
}

dhcp() {
	udhcpc -b -S -t 10 -i "$1" -x hostname:"$(hostname)" \
		-p /var/run/udhcpc.$1.pid >/dev/null 2>&1
}

start() {
	ip link set lo up
	ip addr add 127.0.0.1/8 dev lo 2>/dev/null

	if [ -f "$WPA_CONF" ]; then
		printf "Waiting for wlan0: "
		if wait_iface $WAIT wlan0; then
			echo "OK"
			ip link set wlan0 up
			printf "Starting wpa_supplicant: "
			wpa_supplicant -B -i wlan0 -c "$WPA_CONF" -D nl80211,wext \
				-P /var/run/wpa_supplicant.wlan0.pid -s \
				&& echo "OK" || echo "FAIL"
			dhcp wlan0
		else
			echo "FAIL (no wifi adapter found)"
		fi
	else
		echo "No $WPA_CONF (add network-config to the config partition); skipping wifi"
	fi

	# USB ethernet dongle, if any (asix, smsc95xx, ...).
	for ifc in /sys/class/net/eth*; do
		[ -e "$ifc" ] || continue
		ifc=${ifc##*/}
		ip link set "$ifc" up
		dhcp "$ifc"
	done
}

stop() {
	for p in /var/run/udhcpc.*.pid /var/run/wpa_supplicant.*.pid; do
		[ -f "$p" ] && kill "$(cat "$p")" 2>/dev/null
	done
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart|reload) stop; sleep 1; start ;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
