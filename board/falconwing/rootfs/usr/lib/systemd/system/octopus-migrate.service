[Unit]
Description=Move state from before the rename to Octopus OS
DefaultDependencies=no
After=local-fs.target
Before=systemd-tmpfiles-setup.service octopus-config.service sysinit.target
ConditionPathExists=|/var/lib/chumby
ConditionPathExists=|/var/lib/chumby-root

[Service]
Type=oneshot
ExecStart=/usr/libexec/octopus-migrate

[Install]
WantedBy=sysinit.target
