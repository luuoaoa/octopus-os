#!/bin/sh
# octopus-audio source: AirPlay (shairport-sync, see octopus-airplay-hook).
#
# A receiver can't pause or resume what a phone sends, but it can ask the
# phone (octopus-airplay-remote, DACP): stop and pause both pause it there,
# so it doesn't carry on "playing" to us, then end the session
# (restarting shairport-sync drops the connection and frees the sound
# card). So pause says it didn't (exit 1): nothing to resume after an
# alarm.
#
#   disconnect   the AirPlay app's held button: the phone stops (not just
#                pauses), and the session ends
MARK=/run/shairport-sync/playing

case "$1" in
	active)
		[ -f "$MARK" ]
		;;
	stop | pause | disconnect)
		[ -f "$MARK" ] || [ "$1" = disconnect ] || exit 0
		if [ "$1" = disconnect ]; then
			octopus-airplay-remote stop
		else
			octopus-airplay-remote pause
		fi
		rm -f "$MARK"
		# Restarting a service is root's: the shell does it for the
		# apps' user (we run as whoever plays).
		if [ "$(id -u)" = 0 ]; then
			systemctl restart shairport-sync
		elif [ -p /run/octopus/shell.cmd ]; then
			echo "restart airplay" > /run/octopus/shell.cmd
		fi
		# Not through octopus-audio (nothing else stops): say so.
		[ "$1" = disconnect ] && octopus-audio stopped airplay
		[ "$1" != pause ]
		;;
	resume)
		exit 1
		;;
	*)
		exit 2
		;;
esac
