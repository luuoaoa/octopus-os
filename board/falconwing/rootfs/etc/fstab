# <file system>	<mount pt>	<type>	<options>	<dump>	<pass>
/dev/root	/		ext3	rw,noauto	0	1
proc		/proc		proc	defaults	0	0
sysfs		/sys		sysfs	defaults	0	0
# No ptmxmode= here: devpts on 2.6.28 rejects it (added in 2.6.29).
devpts		/dev/pts	devpts	defaults,gid=5,mode=620	0	0
tmpfs		/dev/shm	tmpfs	mode=1777,size=4m	0	0
tmpfs		/tmp		tmpfs	mode=1777,size=8m	0	0
tmpfs		/run		tmpfs	mode=0755,nosuid,nodev,size=2m	0	0
# FAT config partition (network-config, user-data, authorized_keys).
# Read-only: the device never writes to it, so it's safe to yank the card.
/dev/mmcblk0p3	/boot		vfat	ro,noatime,fmask=0177,dmask=0077	0	0
