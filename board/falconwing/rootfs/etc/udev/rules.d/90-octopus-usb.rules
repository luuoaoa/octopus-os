# USB storage plugged in: install the app bundles on it (FAT, an octopus-apps
# folder at its top; octopus-usb-install). Each partition, and the whole disk
# for a stick formatted without a partition table.
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="octopus-usb-install@%k.service"
