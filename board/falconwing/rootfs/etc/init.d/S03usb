#!/bin/sh
#
# Bring up USB (the internal wifi is a USB device). Mirrors the stock
# reset_usb.sh + "modprobe ehci_hcd": power-cycle the USB root port via
# GPIO bank 0 pin 26 so the rt73/rt3070 re-enumerates cleanly, then load
# the host controller driver. Device drivers then autoload through mdev
# ($MODALIAS rule in /etc/mdev.conf).
#
# i.MX23 HW_PINCTRL_DOUT0 = 0x80018500, _SET = +4, _CLR = +8.
PIN26=0x04000000

case "$1" in
  start)
	printf "Starting USB: "
	# Restore the clock from the RTC (the stock firmware saves it there).
	[ -e /dev/rtc0 ] && hwclock -s -u 2>/dev/null
	devmem 0x80018508 32 $PIN26
	sleep 2
	devmem 0x80018504 32 $PIN26
	modprobe ehci_hcd && echo "OK" || echo "FAIL"
	;;
  stop)
	;;
  *)
	echo "Usage: $0 {start|stop}"
	exit 1
esac
