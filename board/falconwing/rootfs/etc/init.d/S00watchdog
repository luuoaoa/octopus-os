#!/bin/sh
#
# The falconwing bootloader arms the i.MX23 hardware watchdog before
# jumping to the kernel; if userland doesn't take it over the board
# resets. Same as the stock enable_watchdog.sh: load stmp3xxx_wdt and
# keep it fed with busybox watchdog.
#

case "$1" in
  start)
	printf "Starting watchdog: "
	modprobe stmp3xxx_wdt
	# The module's hotplug event normally creates the node; coldplug in
	# case the event raced the mdev setup.
	[ -c /dev/watchdog ] || mdev -s
	if [ -c /dev/watchdog ]; then
		watchdog -T 60 -t 10 /dev/watchdog && echo "OK" || echo "FAIL"
	else
		echo "FAIL (no /dev/watchdog)"
	fi
	;;
  stop)
	# Leave it running: busybox watchdog writes the magic close
	# character on SIGTERM, and a hung shutdown should still reset.
	;;
  *)
	echo "Usage: $0 {start|stop}"
	exit 1
esac
