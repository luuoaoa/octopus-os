# Kernel config fragment merged on top of the bcmrpi defconfig.
# Trims subsystems we don't use on this device, since the rootfs is an
# initramfs that lives in RAM — every byte saved here is RAM saved at
# runtime AND fewer bytes for the kernel to decompress at boot.
#
# We use vfat for /boot, ext4 for /var, and tmpfs for everything else.
# Drop the rest of the in-tree filesystem drivers.
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_BCACHEFS_FS is not set
# CONFIG_OCFS2_FS is not set
# CONFIG_GFS2_FS is not set
# CONFIG_NILFS2_FS is not set
# CONFIG_REISERFS_FS is not set
# CONFIG_NTFS3_FS is not set

# Headless device — no display, no camera. Drop the entire DRM/media stack
# and human-input devices we have no port for.
# CONFIG_DRM_VC4 is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_INPUT_JOYDEV is not set
# CONFIG_INPUT_JOYSTICK is not set
# CONFIG_INPUT_TOUCHSCREEN is not set

# Networking: this is a single-purpose IPv4/IPv6 LAN device that doesn't
# firewall, route, bridge, mesh, or do telecom protocols. Disable
# NETFILTER (kills ip{,6}tables/nftables/ebtables/conntrack modules), the
# unused L4 protocols, exotic L2 protocols, and overlay tunnels.
# CONFIG_NETFILTER is not set
# CONFIG_SCTP is not set
# CONFIG_BATMAN_ADV is not set
# CONFIG_ATM is not set
# CONFIG_LLC is not set
# CONFIG_NETROM is not set
# CONFIG_VXLAN is not set

# Sound: keep ALSA core, the BCM2835 I2S machine driver, and snd-usb-audio
# (the USB audio class driver) — that's enough for an I2S DAC HAT or a
# generic USB audio dongle, which is how shairport-sync will play out.
# Drop the WM5102/Arizona codec (huge, no hardware), MIDI sequencer, OSS
# emulation, and the niche USB-audio device drivers that target specific
# pro-audio interfaces we don't have.
# CONFIG_SND_SOC_WM5102 is not set
# CONFIG_SND_SEQUENCER is not set
# CONFIG_SND_PCM_OSS is not set
# CONFIG_SND_USB_CAIAQ is not set
# CONFIG_SND_USB_LINE6 is not set
# CONFIG_SND_USB_6FIRE is not set
# CONFIG_SND_USB_UA101 is not set
# CONFIG_SND_USB_HIFACE is not set

# Bluetooth: the Pi Zero W's BCM43430 has BT silicon but we don't use it.
# HomeKit goes over WiFi (mDNS + TCP), shairport-sync goes over WiFi
# (AirPlay). Disabling BT kills the entire stack (HCI, RFCOMM, L2CAP,
# BNEP, HIDP, the various transport drivers).
# CONFIG_BT is not set

# Module compression. xz-decompressing ~1100 .ko files at modprobe
# time on an ARMv6 single core is slow; the cpio that contains them
# is already compressed at a higher level, so per-module xz is pure
# overhead at boot. The kernel Kconfig help text explicitly
# recommends NONE when modules live in an initramfs.
# CONFIG_MODULE_COMPRESS is not set

# Wireless: Pi 0W has only the onboard SDIO BCM43430 chip. brcmfmac
# is a FullMAC driver — it talks to cfg80211 directly and does not
# need mac80211 (SoftMAC). Drop mac80211 + every other vendor's WiFi
# drivers. KEEP CONFIG_WLAN_VENDOR_BROADCOM (brcmfmac lives there).
# CONFIG_MAC80211 is not set
# CONFIG_WLAN_VENDOR_ADMTEK is not set
# CONFIG_WLAN_VENDOR_ATH is not set
# CONFIG_WLAN_VENDOR_ATMEL is not set
# CONFIG_WLAN_VENDOR_INTEL is not set
# CONFIG_WLAN_VENDOR_INTERSIL is not set
# CONFIG_WLAN_VENDOR_MARVELL is not set
# CONFIG_WLAN_VENDOR_MEDIATEK is not set
# CONFIG_WLAN_VENDOR_MICROCHIP is not set
# CONFIG_WLAN_VENDOR_PURELIFI is not set
# CONFIG_WLAN_VENDOR_RALINK is not set
# CONFIG_WLAN_VENDOR_REALTEK is not set
# CONFIG_WLAN_VENDOR_RSI is not set
# CONFIG_WLAN_VENDOR_SILABS is not set
# CONFIG_WLAN_VENDOR_ST is not set
# CONFIG_WLAN_VENDOR_TI is not set
# CONFIG_WLAN_VENDOR_ZYDAS is not set
# CONFIG_WLAN_VENDOR_QUANTENNA is not set

# USB networking: Pi 0W has no Ethernet port. Drop the USB ethernet
# adapter drivers — smsc95xx (Pi 3+ onboard), ax8817x, rtl815x,
# pegasus, etc. — none of which would ever bind on this board.
# CONFIG_USB_NET_DRIVERS is not set

# Filesystems: only vfat (/boot) and ext4 (/var) are mounted from
# block devices. Everything tmpfs/proc/sysfs is already separate.
# CONFIG_NFS_FS is not set
# CONFIG_NFSD is not set
# CONFIG_CIFS is not set
# CONFIG_CEPH_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_JFS_FS is not set
# CONFIG_F2FS_FS is not set

# Block layer extras nobody is asking for.
# CONFIG_DRBD is not set
# CONFIG_BCACHE is not set
# CONFIG_DM_MULTIPATH is not set

# DRM/KMS: headless device, no display. DRM_VC4 is already off (above)
# but the DRM core still ships an empty drm.ko. Kill it.
# CONFIG_DRM is not set

# SCSI: Pi 0W's storage is MMC/SDIO (not SCSI), and we don't plug in
# USB mass storage (CONFIG_USB_STORAGE depends on SCSI — going away
# with it).
# CONFIG_SCSI is not set

# Software bridge: no virtual networking, no docker, no VLAN
# trunking — single physical wlan0 in/out is the entire story.
# CONFIG_BRIDGE is not set
