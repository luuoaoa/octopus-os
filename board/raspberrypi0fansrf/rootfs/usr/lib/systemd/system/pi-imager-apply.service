[Unit]
Description=Apply Pi Imager config from /boot/{network-config,user-data}
After=local-fs.target
Before=wpa_supplicant@wlan0.service multi-user.target
RequiresMountsFor=/boot

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/pi-imager-apply.sh

[Install]
WantedBy=multi-user.target
