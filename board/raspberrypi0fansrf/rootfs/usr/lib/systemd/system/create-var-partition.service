[Unit]
Description=Create /var partition on first boot if missing
DefaultDependencies=no
After=systemd-udev-trigger.service
Before=local-fs-pre.target var.mount
ConditionPathExists=/dev/mmcblk0
ConditionPathExists=!/dev/mmcblk0p2

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/create-var-partition.sh

[Install]
WantedBy=local-fs-pre.target
