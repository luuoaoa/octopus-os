[Match]
Name=en* eth*

[Network]
DHCP=yes
IPv6PrivacyExtensions=true

[DHCP]
# Prefer a wired link over WiFi (40-wireless.network uses 20) when both
# happen to be present. A bare Pi Zero (non-W) has no onboard networking,
# so a USB ethernet adapter lands here; on a Zero W this matches nothing
# unless such an adapter is plugged in.
RouteMetric=10
