#!/bin/sh
# chumby-sound: the RasPad's speaker processing, as the Settings app sets
# it (Sound; it runs this as the apps' user, in the pipewire group).
#
#   chumby-sound apply        the bass enhancer and the EQ from
#                             /var/lib/chumby/settings.conf onto the
#                             "raspad-eq" chain, live:
#                               bass = off|low|medium|high  (default off)
#                               eq = off|warm|bright|custom (default off)
#   chumby-sound presets      the EQ choices: id, a tab, its name
#   chumby-sound custom-info  what the custom EQ file gives (one line)
#
# The custom EQ: eq.txt on the config partition (/boot, the FAT one with
# user-data; read at boot), as Room EQ Wizard exports filters (File > Export > Filter
# Settings as text) - Equalizer APO's format too:
#
#   Preamp: -4.0 dB
#   Filter  1: ON  PK       Fc   200.0 Hz  Gain  -3.00 dB  Q  1.500
#   Filter  2: ON  LS       Fc    80.0 Hz  Gain   4.00 dB  Q  0.707
#   Filter  3: ON  HS       Fc  8000.0 Hz  Gain   2.00 dB  Q  0.707
#
# Up to 10 PK, one LS (or LSC), one HS (or HSC); others are skipped. The
# chain (/etc/pipewire/pipewire.conf.d/30-raspad-eq.conf) is always the
# default sink; all off, it passes the sound through.
set -eu

export PIPEWIRE_RUNTIME_DIR="${PIPEWIRE_RUNTIME_DIR:-/run/pipewire}"
SETTINGS=/var/lib/chumby/settings.conf
# /boot/eq.txt, as sdcard-config-apply copies it at boot: /boot is root's.
CUSTOM=/run/chumby-config/eq.txt
EQ_NAME=raspad-eq
N_PK=10

setting() {
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$SETTINGS" 2>/dev/null | tail -1
}

node_id() {
	pw-cli ls Node 2>/dev/null | awk -v target="node.name = \"$1\"" '
		/^	id [0-9]+/          { id = $2; gsub(",", "", id) }
		index($0, target) > 0   { print id; exit }'
}

# An EQ as lines: "pre <gain>", "ls|hs <Hz> <dB> <Q>", "pk <Hz> <dB> <Q>"
# (up to N_PK), "lp <Hz>"; anything not given stays neutral.
eq_lines() {
	case "$1" in
	warm)
		echo "pre 0.7"; echo "ls 150 3 0.7"; echo "hs 5000 -3 0.7" ;;
	bright)
		echo "pre 0.7"; echo "ls 150 -2 0.7"; echo "hs 4000 3 0.7" ;;
	custom)
		[ -f "$CUSTOM" ] || return 0
		tr -d '\r' < "$CUSTOM" | awk -v npk=$N_PK '
			function val(key,   i) {
				for (i = 1; i < NF; i++) if ($i == key) return $(i + 1)
				return ""
			}
			# 10^(dB/20) without libm (busybox awk has no ^ or exp):
			# halve to |y| < 1, the series, square back.
			function gain(db,   y, n, s, t, k) {
				y = db / 20 * 2.302585093; n = 0
				while (y > 1 || y < -1) { y /= 2; n++ }
				s = 1; t = 1
				for (k = 1; k < 16; k++) { t *= y / k; s += t }
				while (n-- > 0) s *= s
				return s
			}
			/^[[:space:]]*Preamp:/ {
				printf "pre %.4f\n", gain($2 + 0); next
			}
			/^[[:space:]]*Filter[[:space:]]*[0-9]*:[[:space:]]*ON/ {
				for (i = 1; i <= NF; i++) if ($i == "ON") { t = $(i + 1); break }
				fc = val("Fc"); g = val("Gain"); q = val("Q"); if (q == "") q = 0.707
				if (fc == "" || g == "") { print "skip", t; next }
				if (t == "PK" && pk < npk) { pk++; print "pk", fc, g, q }
				else if ((t == "LS" || t == "LSC") && !ls) { ls = 1; print "ls", fc, g, q }
				else if ((t == "HS" || t == "HSC") && !hs) { hs = 1; print "hs", fc, g, q }
				else print "skip", t
			}' ;;
	esac
}

case "${1:-}" in
presets)
	printf 'off\tOff\nwarm\tWarm\nbright\tBright\ncustom\tCustom\n'
	;;
custom-info)
	if [ ! -f "$CUSTOM" ]; then
		echo "No eq.txt found at the last boot."
	else
		lines=$(eq_lines custom)
		n=$(printf '%s\n' "$lines" | grep -c -E '^(pk|ls|hs) ' || true)
		s=$(printf '%s\n' "$lines" | grep -c '^skip' || true)
		echo "eq.txt: $n filter(s)$( [ "$s" -gt 0 ] && echo ", $s skipped (not PK, LS or HS)")."
	fi
	;;
apply)
	id=$(node_id "$EQ_NAME")
	[ -n "$id" ] || { echo "chumby-sound: no $EQ_NAME node" >&2; exit 1; }
	bass=$(setting bass); eq=$(setting eq)
	case "$bass" in on) bass=medium ;; low|medium|high) ;; *) bass=off ;; esac
	case "$eq" in warm|bright|custom) ;; *) eq=off ;; esac

	# The bass enhancer: how much of its harmonics, and the headroom for them.
	case "$bass" in
		low) bypass=0.0 amt=1.5 bass_pre=0.9 ;;
		medium) bypass=0.0 amt=3.0 bass_pre=0.8 ;;
		high) bypass=0.0 amt=5.0 bass_pre=0.7 ;;
		*) bypass=1.0 amt=1.5 bass_pre=1.0 ;;
	esac

	# Neutral first, then the EQ's lines over it.
	pre=1.0 ls="100 0 0.7" hs="8000 0 0.7" lp=20000
	i=1; pks=
	while [ $i -le $N_PK ]; do pks="$pks|1000 0 1.0"; i=$((i + 1)); done
	lines=$(eq_lines "$eq")
	n=0
	OLDIFS=$IFS; IFS='
'
	for l in $lines; do
		IFS=$OLDIFS
		set -- $l
		case "$1" in
			pre) pre=$2 ;;
			ls) ls="$2 $3 $4" ;;
			hs) hs="$2 $3 $4" ;;
			lp) lp=$2 ;;
			pk) n=$((n + 1)); pks=$(printf '%s' "$pks" | awk -F'|' -v n=$n -v v="$2 $3 $4" \
				'{ $(n + 1) = v; OFS = "|"; $1 = $1; print }') ;;
		esac
	done
	IFS=$OLDIFS
	pre=$(awk -v a="$pre" -v b="$bass_pre" 'BEGIN { printf "%.4f", a * b }')

	params="\"bass:bypass\" $bypass \"bass:amt\" $amt"
	for ch in L R; do
		set -- $ls; params="$params \"pre_$ch:Gain 1\" $pre \"ls_$ch:Freq\" $1 \"ls_$ch:Gain\" $2 \"ls_$ch:Q\" $3"
		set -- $hs; params="$params \"hs_$ch:Freq\" $1 \"hs_$ch:Gain\" $2 \"hs_$ch:Q\" $3 \"lp_$ch:Freq\" $lp"
		i=1
		while [ $i -le $N_PK ]; do
			set -- $(printf '%s' "$pks" | cut -d'|' -f$((i + 1)))
			params="$params \"pk_${ch}_$i:Freq\" $1 \"pk_${ch}_$i:Gain\" $2 \"pk_${ch}_$i:Q\" $3"
			i=$((i + 1))
		done
	done
	# Every value a float ("3" would be an Int the filters ignore).
	params=$(printf '%s\n' "$params" | sed -E 's/" (-?[0-9]+)( |$)/" \1.0\2/g; s/" (-?[0-9]+)( |$)/" \1.0\2/g')
	pw-cli set-param "$id" Props "{ params = [ $params ] }" >/dev/null
	wpctl set-default "$id"
	echo "bass $bass, eq $eq"
	;;
*)
	sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
	exit 2
	;;
esac
