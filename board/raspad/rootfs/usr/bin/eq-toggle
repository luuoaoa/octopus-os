#!/bin/sh
# eq-toggle [on|off|toggle|status]   (default: toggle)
#
# Switch PipeWire's default sink between the "raspad-eq" filter chain
# (bankstown bass + EQ in the path) and the bare HDMI sink it feeds (EQ
# bypassed). WirePlumber remembers the choice (/var/lib/wireplumber), so
# it holds across reboots. From pifansrf's pi-radio eq-toggle.
set -eu

export PIPEWIRE_RUNTIME_DIR="${PIPEWIRE_RUNTIME_DIR:-/run/pipewire}"

EQ_NAME='raspad-eq'
# The chain's own output names its target: the hardware sink.
CONF=/etc/pipewire/pipewire.conf.d/30-raspad-eq.conf
HW_NAME=$(sed -n 's/^[[:space:]]*target\.object[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$CONF" | head -1)

find_id_by_name() {
    pw-cli ls Node 2>/dev/null | awk -v target="node.name = \"$1\"" '
        /^	id [0-9]+/          { id = $2; gsub(",", "", id) }
        index($0, target) > 0   { print id; exit }
    '
}

current_name() {
    # wpctl inspect indents properties and stars the permanent ones.
    wpctl inspect @DEFAULT_AUDIO_SINK@ 2>/dev/null \
        | sed -n 's/^[[:space:]]*\*\{0,1\}[[:space:]]*node\.name = "\(.*\)"/\1/p' \
        | head -1
}

EQ_ID=$(find_id_by_name "$EQ_NAME")
HW_ID=$(find_id_by_name "$HW_NAME")
if [ -z "$EQ_ID" ] || [ -z "$HW_ID" ]; then
    echo "eq-toggle: sinks not found: $EQ_NAME=${EQ_ID:-?} $HW_NAME=${HW_ID:-?}" >&2
    exit 1
fi

on()  { wpctl set-default "$EQ_ID"; echo "EQ on  (default sink: $EQ_NAME)"; }
off() { wpctl set-default "$HW_ID"; echo "EQ off (default sink: $HW_NAME)"; }

case "${1:-toggle}" in
    on) on ;;
    off) off ;;
    toggle) if [ "$(current_name)" = "$EQ_NAME" ]; then off; else on; fi ;;
    status)
        cur=$(current_name)
        if [ "$cur" = "$EQ_NAME" ]; then echo "EQ on  (default sink: $cur)"
        else echo "EQ off (default sink: $cur)"; fi
        ;;
    *) echo "usage: $0 [on|off|toggle|status]" >&2; exit 2 ;;
esac
