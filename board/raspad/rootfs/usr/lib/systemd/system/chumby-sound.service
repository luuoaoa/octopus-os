[Unit]
Description=The speakers' bass and EQ, as set in Settings (chumby-sound)
After=wireplumber.service
Wants=wireplumber.service

[Service]
Type=oneshot
User=chumby
Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire
# The chain's node appears a moment after WirePlumber starts.
ExecStartPre=/bin/sh -c 'i=0; until pw-cli ls Node 2>/dev/null | grep -q "node.name = \\"raspad-eq\\""; do i=$((i + 1)); [ $i -lt 30 ] || exit 1; sleep 1; done'
ExecStart=/usr/bin/chumby-sound apply

[Install]
WantedBy=multi-user.target
