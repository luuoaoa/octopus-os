# The root (squashfs + tmpfs overlay in RAM), /var (bound from the p2
# carrier, mounted at /media/sd) and /dev, /proc, /sys, /run are set up
# by /sbin/init-ram and systemd.
# <file system>	<mount pt>	<type>	<options>	<dump>	<pass>
tmpfs		/tmp		tmpfs	mode=1777,size=8m	0	0
# FAT config partition (network-config, user-data, authorized_keys), ro.
/dev/mmcblk0p3	/boot		vfat	ro,noatime,fmask=0177,dmask=0077,nofail	0	0
