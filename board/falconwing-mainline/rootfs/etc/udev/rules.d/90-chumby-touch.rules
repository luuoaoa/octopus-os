# Map the 4-wire resistive touchscreen's raw 12-bit LRADC values onto the
# 320x240 panel for libinput (used by chumby-wm). Derived from the vendor
# driver's calibration (stmp3xxx_ts.c): X 3930 -> 0 .. 125 -> 320 (inverted),
# Y 130 -> 0 .. 4000 -> 240, over the device's 0..4095 range:
#   x' = -1.0762 x + 1.0329,  y' = 1.0581 y - 0.0336   (normalised 0..1)
ACTION=="add|change", KERNEL=="event*", ATTRS{name}=="mxs-lradc-ts", \
	ENV{ID_INPUT}="1", ENV{ID_INPUT_TOUCHSCREEN}="1", \
	ENV{LIBINPUT_CALIBRATION_MATRIX}="-1.0762 0 1.0329 0 1.0581 -0.0336"
