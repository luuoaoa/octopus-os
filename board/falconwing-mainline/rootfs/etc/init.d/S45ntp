#!/bin/sh
#
# Network time. The SoC's RTC keeps time across a reboot but not a power
# cut (no battery), so the clock may start at 1970: restore what the RTC
# has, then let busybox ntpd step it once the network is up (it retries
# until then) and write the result back to the RTC.
#
# Servers: NTP_SERVERS in /etc/default/ntp.

NTP_SERVERS="0.pool.ntp.org 1.pool.ntp.org 2.pool.ntp.org"
[ -r /etc/default/ntp ] && . /etc/default/ntp
PIDFILE=/var/run/ntpd.pid

case "$1" in
	start)
		printf "Starting ntpd: "
		hwclock -s -u 2>/dev/null
		args=
		for s in $NTP_SERVERS; do
			args="$args -p $s"
		done
		start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /usr/sbin/ntpd -- \
			-n $args -S /usr/sbin/ntp-sync
		[ $? = 0 ] && echo "OK" || echo "FAIL"
		;;
	stop)
		printf "Stopping ntpd: "
		start-stop-daemon -K -q -p "$PIDFILE"
		rm -f "$PIDFILE"
		echo "OK"
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
