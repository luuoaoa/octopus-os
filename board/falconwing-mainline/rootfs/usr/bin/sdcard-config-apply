#!/bin/sh
# Apply the user-editable config from the card's FAT partition (/boot) to
# the system. Runs every boot (octopus-config.service); edit the files on
# the card from any PC and reboot to change settings.
#
#   /boot/wpa_supplicant.conf  used verbatim if present (power users), else
#   /boot/network-config       Pi Imager style; first access point wins:
#                                wifis:
#                                  wlan0:
#                                    access-points:
#                                      "MySSID":
#                                        password: "passphrase or 64-hex PSK"
#                                        hidden: true      # optional
#   /boot/user-data            hostname: chumby
#                              timezone: Europe/Berlin  (a tz database name)
#                              location: 37.77,-122.42  (FM station names/art;
#                                        default: guessed from the IP address)
#                              ssh: true|false  (the SSH server; default false.
#                                        The Settings app's choice, once made,
#                                        wins: /var/lib/octopus-root)
#                              ssh_pwauth: true|false  (password logins; default
#                                        true. Given at all, it also means
#                                        ssh: true, as cards before "ssh:" had)
#                              passwd: <crypt hash, e.g. from mkpasswd -m sha-512>
#   /boot/authorized_keys      installed as /root/.ssh/authorized_keys
#   /boot/eq.txt               the custom speaker EQ (Room EQ Wizard's filter
#                              export; where there is one: octopus-sound),
#                              copied for the apps to read (/boot is root's)
#
set -u

BOOT=/boot
log() { echo "sdcard-config: $*"; logger -t sdcard-config "$*" 2>/dev/null; }

strip() {
    s=${1#"${1%%[![:space:]]*}"}
    s=${s%"${s##*[![:space:]]}"}
    s=${s#\"}; s=${s%\"}
    s=${s#\'}; s=${s%\'}
    printf '%s' "$s"
}

# FAT tools sometimes leave CRLF line endings; strip them into a temp copy.
unix() { tr -d '\r' < "$1"; }

# Where the results go: the root is read-only (the Chumby One) or treated
# so, and its /etc entries are symlinks into /run/octopus-config (see
# post-fakeroot.sh), so everything is written there, in RAM, every boot.
OUT=/run/octopus-config
mkdir -p "$OUT"
WPA=$OUT/wpa_supplicant-wlan0.conf
HOSTNAME_FILE=$OUT/hostname
LOCALTIME=$OUT/localtime
TIMEZONE_FILE=$OUT/timezone
SHADOW_IN=/etc/shadow.default
SHADOW=$OUT/shadow
AUTH_KEYS=$OUT/authorized_keys
DROPBEAR_DEFAULT=$OUT/dropbear
LOCATION_FILE=$OUT/location
EQ_FILE=$OUT/eq.txt

if ! mountpoint -q "$BOOT"; then
    mount "$BOOT" 2>/dev/null || { log "no config partition at $BOOT; nothing to apply"; exit 0; }
fi

# === WiFi ===
if [ -f "$BOOT/wpa_supplicant.conf" ]; then
    unix "$BOOT/wpa_supplicant.conf" > "$WPA.new" && mv "$WPA.new" "$WPA"
    chmod 600 "$WPA"
    log "using $BOOT/wpa_supplicant.conf verbatim"
elif [ -f "$BOOT/network-config" ]; then
    NET=$(unix "$BOOT/network-config")
    SSID=$(printf '%s\n' "$NET" | sed -nE '/^[[:space:]]+access-points:/,$ {
        /access-points:/d
        s/^[[:space:]]+"([^"]+)":[[:space:]]*$/\1/p
        s/^[[:space:]]+'"'"'([^'"'"']+)'"'"':[[:space:]]*$/\1/p
        s/^[[:space:]]+([^"'"'"'[:space:]#][^:]*):[[:space:]]*$/\1/p
    }' | grep -v '^password$\|^hidden$' | head -1)
    SSID=$(strip "$SSID")
    PSK=$(printf '%s\n' "$NET" | sed -nE 's/^[[:space:]]+password:[[:space:]]+(.*)$/\1/p' | head -1)
    PSK=$(strip "$PSK")
    HIDDEN=
    printf '%s\n' "$NET" | grep -qE '^[[:space:]]+hidden:[[:space:]]+true[[:space:]]*$' && HIDDEN=1

    if [ -n "$SSID" ]; then
        if [ -z "$PSK" ]; then
            KEY="    key_mgmt=NONE"
        elif [ ${#PSK} -eq 64 ] && ! printf '%s' "$PSK" | grep -q '[^0-9a-fA-F]'; then
            KEY="    psk=$PSK"
        else
            KEY="    psk=\"$PSK\""
        fi
        {
            echo "ctrl_interface=/var/run/wpa_supplicant"
            echo "ap_scan=1"
            echo
            echo "network={"
            echo "    ssid=\"$SSID\""
            echo "$KEY"
            [ -n "$HIDDEN" ] && echo "    scan_ssid=1"
            echo "}"
        } > "$WPA.new" && mv "$WPA.new" "$WPA"
        chmod 600 "$WPA"
        log "wifi: ssid=[$SSID] psk_len=${#PSK} hidden=${HIDDEN:-0}"
    else
        log "WARN: no access point found in $BOOT/network-config"
    fi
else
    log "no network-config on $BOOT; keeping existing $WPA (if any)"
fi

# === user-data ===
SSH_PWAUTH=true
SSH_ON=false
if [ -f "$BOOT/user-data" ]; then
    USR=$(unix "$BOOT/user-data")

    HOST=$(strip "$(printf '%s\n' "$USR" | sed -nE 's/^hostname:[[:space:]]+(.*)$/\1/p' | head -1)")
    if [ -n "$HOST" ]; then
        echo "$HOST" > "$HOSTNAME_FILE"
        hostname "$HOST"
        log "hostname=$HOST"
    fi

    TZNAME=$(strip "$(printf '%s\n' "$USR" | sed -nE 's/^timezone:[[:space:]]+(.*)$/\1/p' | head -1)")
    if [ -n "$TZNAME" ]; then
        if [ -f "/usr/share/zoneinfo/$TZNAME" ]; then
            ln -sf "/usr/share/zoneinfo/$TZNAME" "$LOCALTIME"
            echo "$TZNAME" > "$TIMEZONE_FILE"
            log "timezone=$TZNAME"
        else
            log "WARN: unknown timezone '$TZNAME' (no /usr/share/zoneinfo/$TZNAME)"
        fi
    fi

    LOC=$(strip "$(printf '%s\n' "$USR" | sed -nE 's/^location:[[:space:]]+(.*)$/\1/p' | head -1)")
    case "$LOC" in
        *[0-9],*[0-9]) echo "$LOC" | tr -d ' ' > "$LOCATION_FILE"; log "location=$LOC" ;;
        "") ;;
        *) log "WARN: location: '$LOC' is not <lat>,<lon>; ignoring" ;;
    esac

    V=$(strip "$(printf '%s\n' "$USR" | sed -nE 's/^ssh_pwauth:[[:space:]]+(.*)$/\1/p' | head -1)")
    case "$V" in
        false|False|FALSE|no|0) SSH_PWAUTH=false ;;
    esac
    [ -n "$V" ] && SSH_ON=true
    V=$(strip "$(printf '%s\n' "$USR" | sed -nE 's/^ssh:[[:space:]]+(.*)$/\1/p' | head -1)")
    case "$V" in
        true|True|TRUE|yes|1) SSH_ON=true ;;
        false|False|FALSE|no|0) SSH_ON=false ;;
    esac

    PW=$(printf '%s\n' "$USR" | sed -nE 's/^[[:space:]]*passwd:[[:space:]]+"?(\$[0-9a-zA-Z]+\$[^"[:space:]]+)"?[[:space:]]*$/\1/p' | head -1)
    if [ -n "$PW" ]; then
        case "$PW" in
            *\$*\$*\$*)
                if awk -F: -v OFS=: -v h="$PW" '$1=="root"{$2=h} 1' "$SHADOW_IN" > "$SHADOW.new" \
                   && [ -s "$SHADOW.new" ]; then
                    chmod 600 "$SHADOW.new"
                    mv "$SHADOW.new" "$SHADOW"
                    log "root password hash updated from user-data"
                else
                    rm -f "$SHADOW.new"
                    log "WARN: failed to rewrite $SHADOW"
                fi
                ;;
            *) log "WARN: passwd: is not a \$id\$salt\$hash crypt string; ignoring" ;;
        esac
    fi
fi

# === What the Settings app set (octopus-setting): over user-data ===
ROOT_STATE=/var/lib/octopus-root
if [ -f "$ROOT_STATE/timezone" ]; then
    TZNAME=$(cat "$ROOT_STATE/timezone")
    if [ -f "/usr/share/zoneinfo/$TZNAME" ]; then
        ln -sf "/usr/share/zoneinfo/$TZNAME" "$LOCALTIME"
        echo "$TZNAME" > "$TIMEZONE_FILE"
        log "timezone=$TZNAME (Settings)"
    fi
fi
if [ -s "$ROOT_STATE/root.hash" ]; then
    PW=$(cat "$ROOT_STATE/root.hash")
    awk -F: -v OFS=: -v h="$PW" '$1=="root"{$2=h} 1' "$SHADOW" > "$SHADOW.new" &&
        chmod 600 "$SHADOW.new" && mv "$SHADOW.new" "$SHADOW" &&
        log "root password from Settings"
fi
case "$(cat "$ROOT_STATE/ssh" 2>/dev/null)" in
    on) SSH_ON=true; SSH_PWAUTH=true; log "ssh: on (Settings)" ;;
    off) SSH_ON=false; log "ssh: off (Settings)" ;;
esac

# === SSH ===
# The server runs only when on (dropbear.service: ConditionPathExists).
if [ -d /run/systemd/system ]; then
    if [ "$SSH_ON" = true ]; then touch "$OUT/ssh-on"; else rm -f "$OUT/ssh-on"; fi
fi
if [ -f "$BOOT/authorized_keys" ]; then
    mkdir -p "$(dirname "$AUTH_KEYS")"
    unix "$BOOT/authorized_keys" > "$AUTH_KEYS"
    chmod 600 "$AUTH_KEYS"
    log "installed $(grep -c . "$AUTH_KEYS") authorized key(s)"
fi

# === The custom EQ: readable to the apps (the FAT is root's only) ===
if [ -f "$BOOT/eq.txt" ]; then
    unix "$BOOT/eq.txt" > "$EQ_FILE.new" && chmod 644 "$EQ_FILE.new" &&
        mv "$EQ_FILE.new" "$EQ_FILE"
    log "custom EQ: $BOOT/eq.txt"
else
    rm -f "$EQ_FILE"
fi

if [ "$SSH_PWAUTH" = true ]; then
    echo 'DROPBEAR_ARGS=""' > "$DROPBEAR_DEFAULT"
    log "ssh: password logins enabled"
else
    # -s: disable password logins, -g: disable them for root too.
    echo 'DROPBEAR_ARGS="-s -g"' > "$DROPBEAR_DEFAULT"
    log "ssh: key-only logins"
fi

exit 0
