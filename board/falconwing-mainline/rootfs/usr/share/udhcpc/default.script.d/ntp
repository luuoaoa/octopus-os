#!/bin/sh
# udhcpc hook: once an interface has an address, (re)start ntpd. At boot
# it starts before WiFi is up and gives up resolving its servers, leaving
# the clock in 1970 (no RTC battery).
case "$1" in
	bound)
		[ -x /etc/init.d/S45ntp ] && /etc/init.d/S45ntp restart >/dev/null 2>&1 &
		;;
esac
exit 0
