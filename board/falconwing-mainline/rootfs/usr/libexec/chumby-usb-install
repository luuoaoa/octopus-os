#!/bin/sh
# A USB stick (or card reader) plugged in: the bundles in its chumby-apps/
# folder installed (chumby-install), the stick unmounted again. Started by
# udev (90-chumby-usb.rules) through chumby-usb-install@<dev>.service.
DEV=/dev/$1
MNT=/run/chumby-usb/$1

mkdir -p "$MNT"
mount -t vfat -o ro,nosuid,nodev,noexec "$DEV" "$MNT" 2>/dev/null || {
	rmdir "$MNT"
	exit 0		# not FAT (or the whole disk of a partitioned stick): not ours
}
n=0
for b in "$MNT"/chumby-apps/*.chumbyapp "$MNT"/chumby-apps/*/; do
	[ -e "$b" ] || continue
	[ -d "$b" ] && [ ! -f "$b/app.conf" ] && continue
	if chumby-install "${b%/}"; then
		n=$((n + 1))
	fi
done
umount "$MNT"
rmdir "$MNT"
echo "chumby-usb-install: $n bundle(s) from $DEV"
