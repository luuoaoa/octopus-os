# Chumby One (falconwing) on top of arch/arm/configs/mxs_defconfig.

# Boot: the stock chumby bootloader loads the zImage with the DTB appended
# (buildroot enables ARM_APPENDED_DTB) into the 4 MiB krnA slot. Its ATAG
# cmdline targets the vendor kernel, so ignore ATAGs and use DT bootargs.
# CONFIG_ARM_ATAG_DTB_COMPAT is not set

# Earliest possible output on the DUART: the serial RX line is the only
# way to see a failed boot.
CONFIG_DEBUG_LL=y
CONFIG_DEBUG_IMX23_UART=y
CONFIG_EARLY_PRINTK=y

# Watchdog: armed (20 s) by the bootloader; the board patch makes the
# watchdog core feed it until userspace takes over.
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_STMP3XXX_RTC_WATCHDOG=y
CONFIG_RTC_DRV_STMP=y

CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_EXT4_FS=y
# Root runs from RAM: /sbin/init-ram on p2 copies rootfs.squashfs into a
# tmpfs, loop-mounts it and puts a tmpfs overlay on top. Built in: all of
# it happens before any module could be loaded.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
# (mxs_defconfig has the whole "Block devices" menu off: without BLK_DEV
# the loop option is silently dropped.)
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_OVERLAY_FS=y
# Keep the RTC in step once timesyncd has synchronised the clock.
CONFIG_RTC_SYSTOHC=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Size: mxs_defconfig's debug and board options don't fit the 4 MiB krnA
# slot together with what this board needs, and none of them apply.
# CONFIG_PROVE_LOCKING is not set
# CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT is not set
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_USER is not set
# CONFIG_MTD is not set
# CONFIG_JFFS2_FS is not set
# CONFIG_UBIFS_FS is not set
# CONFIG_NFS_FS is not set
# CONFIG_ROOT_NFS is not set
# CONFIG_IP_PNP is not set
# CONFIG_CAN is not set
# CONFIG_ENC28J60 is not set
# CONFIG_ICPLUS_PHY is not set
# CONFIG_MICREL_PHY is not set
# CONFIG_REALTEK_PHY is not set
# CONFIG_EEPROM_AT24 is not set
# CONFIG_TOUCHSCREEN_EDT_FT5X06 is not set
# CONFIG_TOUCHSCREEN_TSC2007 is not set
# CONFIG_DRM_PANEL_SEIKO_43WVF1G is not set
# CONFIG_SND_SOC_MXS_SGTL5000 is not set
# CONFIG_SND_SOC_TLV320AIC3X_I2C is not set
# CONFIG_SPI_MXS is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_CHIPIDEA_UDC is not set
# CONFIG_SERIAL_MXS_AUART is not set
# Lock debugging pulled in by mxs_defconfig's PROVE_LOCKING stays set
# after disabling PROVE_LOCKING itself; turn it off explicitly.
# CONFIG_LOCKDEP is not set
# CONFIG_DEBUG_LOCK_ALLOC is not set
# CONFIG_DEBUG_RT_MUTEXES is not set
# CONFIG_DEBUG_SPINLOCK is not set
# CONFIG_DEBUG_MUTEXES is not set
# CONFIG_DEBUG_WW_MUTEX_SLOWPATH is not set
# CONFIG_DEBUG_RWSEMS is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SOFTLOCKUP_DETECTOR is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_FTRACE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_BLK_DEV_INTEGRITY is not set
# CONFIG_TASKSTATS is not set

# (zImage compression is set in the defconfig: buildroot owns that choice.)

# Not needed to reach userspace: build as modules (loaded from the rootfs)
# to keep the zImage small and leave room for later bring-up phases.
CONFIG_DRM=m
CONFIG_DRM_MXSFB=m
CONFIG_SND=m
CONFIG_SND_SOC=m
CONFIG_USB=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_CHIPIDEA=m
CONFIG_USB_STORAGE=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_SMSC95XX=m
CONFIG_CRYPTO_DEV_MXS_DCP=m
CONFIG_HID=m

# --- Phase 2: USB host, wifi, I2C ---
# Internal USB wifi: RT3070-class (stock shipped rt2870.bin) or rt73;
# both drivers as modules, autoloaded via mdev's MODALIAS coldplug.
CONFIG_WIRELESS=y
CONFIG_CFG80211=m
CONFIG_MAC80211=m
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_RALINK=y
CONFIG_RT2X00=m
CONFIG_RT2800USB=m
CONFIG_RT2800USB_RT33XX=y
CONFIG_RT2800USB_RT35XX=y
CONFIG_RT2800USB_RT3573=y
CONFIG_RT2800USB_RT53XX=y
CONFIG_RT2800USB_RT55XX=y
CONFIG_RT2800USB_UNKNOWN=y
CONFIG_RT73USB=m
CONFIG_RT2500USB=m
# USB ethernet dongles as a wired fallback.
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8152=m
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_MXS_PHY=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_MXS=y
# The FM tuner's reads need protocol mangling: bit-banged bus (see DTS).
CONFIG_I2C_GPIO=y

# --- Phase 3: display, backlight, touch, knob ---
CONFIG_DRM_PANEL_SIMPLE=m
# mxsfb's buffers must be physically contiguous (~300 KB each). With the
# rootfs in RAM, memory fragments and allocating them failed on hardware
# ("Failed to create DRM dumb buffer", frozen screen): reserve a CMA pool.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_MBYTES=4
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_TOUCHSCREEN_MXS_LRADC=m
CONFIG_INPUT_GPIO_ROTARY_ENCODER=m
# Snooze button (top of the case) on a GPIO
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=m

# --- Phase 4: audio ---
CONFIG_SND_MXS_SOC=m
CONFIG_SND_SOC_IMX23_AUDIO=m
CONFIG_SND_SIMPLE_CARD=m
CONFIG_SND_SOC_SIMPLE_AMPLIFIER=m

# --- CPU frequency scaling (cpufreq-dt, divider-only, see DT + patch 0004) ---
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
# Boot at full speed: AHB (which the LCDIF fetches the framebuffer over)
# is divided down with the CPU, and every frequency change glitches the
# panel (seen on hardware with ondemand: a jerk about once a second).
# chumby-shell switches to powersave while the screen is off.
CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_GOV_POWERSAVE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_CONSERVATIVE=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
