// SPDX-License-Identifier: GPL-2.0-or-later
/*
 * Chumby One ("falconwing"): Freescale i.MX233, 64 MiB DDR, boots from
 * microSD through the stock chumby bootloader (zImage + appended DTB in
 * the krnA slot of partition 1).
 *
 * Hardware facts come from Chumby's 2.6.28 vendor kernel
 * (linux-2.6.28.mx233, arch/arm/mach-stmp3xxx/ and drivers).
 * Vendor GPIO notation used below: B<bank>P<pin>.
 */

/dts-v1/;
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include "nxp/mxs/imx23.dtsi"

/ {
	model = "Chumby One (falconwing)";
	compatible = "chumby,falconwing", "fsl,imx23";

	aliases {
		mmc0 = &ssp0;
		i2c0 = &i2c_gpio;
	};

	chosen {
		/*
		 * The stock bootloader's cmdline (console=ttyAM0, init=/linuxrc,
		 * rootfstype=ext3) is for the vendor kernel; ARM_ATAG_DTB_COMPAT
		 * is off, so these bootargs are used instead.
		 */
		/* p2 only carries the early boot and the rootfs image: init-ram
		 * mounts the image read-only as the root, then starts systemd. */
		bootargs = "console=ttyAMA0,115200 earlyprintk root=/dev/mmcblk0p2 rootfstype=ext4 rootwait rw init=/sbin/init-ram";
		stdout-path = &duart;
	};

	/*
	 * CPU frequency scaling. The bootloader runs the CPU at the Chumby
	 * One's rated 454.74 MHz (PLL 480 MHz * 18/19, DIV_CPU 1) with VDDD
	 * set for it. There is no mainline i.MX23 regulator driver to raise
	 * VDDD, so only scale *down* from there: patch 0004 restricts CPU
	 * rate changes to the integer DIV_CPU divider, and these OPPs are
	 * that rate / 1..4 (as the divider rounds them). AHB (hbus) is a
	 * fixed divider of the CPU clock and follows it down; EMI/DRAM is
	 * clocked separately and unaffected.
	 */
	cpu_opp_table: opp-table {
		compatible = "operating-points-v2";

		opp-113684211 {
			opp-hz = /bits/ 64 <113684211>;
			clock-latency-ns = <50000>;
		};

		opp-151578948 {
			opp-hz = /bits/ 64 <151578948>;
			clock-latency-ns = <50000>;
		};

		opp-227368421 {
			opp-hz = /bits/ 64 <227368421>;
			clock-latency-ns = <50000>;
		};

		opp-454736842 {
			opp-hz = /bits/ 64 <454736842>;
			clock-latency-ns = <50000>;
		};
	};

	memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 0x04000000>;
	};

	apb@80000000 {
		apbh-bus@80000000 {
			/* SSP1 (ssp0 here): microSD, 4-bit. The card is the root
			 * device and never leaves while running. */
			ssp0: spi@80010000 {
				compatible = "fsl,imx23-mmc";
				pinctrl-names = "default";
				pinctrl-0 = <&mmc0_4bit_pins_a &mmc0_sck_cfg>;
				bus-width = <4>;
				non-removable;
				status = "okay";
			};

			lcdif@80030000 {
				pinctrl-names = "default";
				pinctrl-0 = <&lcdif_18bit_pins_chumby>;
				status = "okay";

				port {
					lcdif_out: endpoint {
						remote-endpoint = <&panel_in>;
					};
				};
			};

			pinctrl@80018000 {
				pinctrl-names = "default";
				pinctrl-0 = <&chumby_hog_pins>;

				/*
				 * Board power/reset lines the vendor kernel drove with raw
				 * PINCTRL writes (drivers/power/stmp37xx/linux.c,
				 * drivers/usb/host/ehci-arc.c). The bootloader leaves
				 * them configured; mux them as GPIOs so Linux owns them.
				 */
				chumby_hog_pins: chumby-hog@0 {
					reg = <0>;
					fsl,pinmux-ids = <
						MX23_PAD_GPMI_D12__GPIO_0_12	/* LOCAL_5V_ON: USB + wifi 5 V */
						MX23_PAD_AUART1_CTS__GPIO_0_26	/* USB power enable */
						MX23_PAD_AUART1_TX__GPIO_0_29	/* USB reset, active low */
						MX23_PAD_LCD_RESET__GPIO_1_18	/* panel reset, active low */
						MX23_PAD_GPMI_D08__GPIO_0_8	/* external speaker amp, high = mute */
						MX23_PAD_GPMI_D11__GPIO_0_11	/* headphone detect, low = plugged */
					>;
					fsl,drive-strength = <MXS_DRIVE_4mA>;
					fsl,voltage = <MXS_VOLTAGE_HIGH>;
					fsl,pull-up = <MXS_PULL_DISABLE>;
				};

				/* 18-bit RGB666 DOTCLK panel (vendor stmp378x_lcd_pins
				 * minus the GPMI_D08-13 upper bits, which Chumby uses as
				 * GPIOs). */
				lcdif_18bit_pins_chumby: lcdif-18bit-chumby@0 {
					reg = <0>;
					fsl,pinmux-ids = <
						MX23_PAD_LCD_D00__LCD_D00
						MX23_PAD_LCD_D01__LCD_D01
						MX23_PAD_LCD_D02__LCD_D02
						MX23_PAD_LCD_D03__LCD_D03
						MX23_PAD_LCD_D04__LCD_D04
						MX23_PAD_LCD_D05__LCD_D05
						MX23_PAD_LCD_D06__LCD_D06
						MX23_PAD_LCD_D07__LCD_D07
						MX23_PAD_LCD_D08__LCD_D08
						MX23_PAD_LCD_D09__LCD_D09
						MX23_PAD_LCD_D10__LCD_D10
						MX23_PAD_LCD_D11__LCD_D11
						MX23_PAD_LCD_D12__LCD_D12
						MX23_PAD_LCD_D13__LCD_D13
						MX23_PAD_LCD_D14__LCD_D14
						MX23_PAD_LCD_D15__LCD_D15
						MX23_PAD_LCD_D16__LCD_D16
						MX23_PAD_LCD_D17__LCD_D17
						MX23_PAD_LCD_DOTCK__LCD_DOTCK
						MX23_PAD_LCD_ENABLE__LCD_ENABLE
						MX23_PAD_LCD_HSYNC__LCD_HSYNC
						MX23_PAD_LCD_VSYNC__LCD_VSYNC
					>;
					fsl,drive-strength = <MXS_DRIVE_12mA>;
					fsl,voltage = <MXS_VOLTAGE_HIGH>;
					fsl,pull-up = <MXS_PULL_DISABLE>;
				};

				/* Knob: the vendor kernel used the TIMROT hardware
				 * quadrature decoder on ROTARYA/B, which has no mainline
				 * driver; read the same pins as GPIOs instead. */
				/* I2C_SCL/SDA (B0P30/31) as GPIOs for i2c-gpio. */
				i2c_gpio_pins: i2c-gpio@0 {
					reg = <0>;
					fsl,pinmux-ids = <
						MX23_PAD_I2C_SCL__GPIO_0_30
						MX23_PAD_I2C_SDA__GPIO_0_31
					>;
					fsl,drive-strength = <MXS_DRIVE_8mA>;
					fsl,voltage = <MXS_VOLTAGE_HIGH>;
					fsl,pull-up = <MXS_PULL_ENABLE>;
				};

				rotary_pins: rotary@0 {
					reg = <0>;
					fsl,pinmux-ids = <
						MX23_PAD_ROTARYA__GPIO_2_7
						MX23_PAD_ROTARYB__GPIO_2_8
					>;
					fsl,drive-strength = <MXS_DRIVE_4mA>;
					fsl,voltage = <MXS_VOLTAGE_HIGH>;
					fsl,pull-up = <MXS_PULL_DISABLE>;
				};

				/* Snooze button on top of the case: the vendor
				 * chumby_bend driver ("2.3-Falconwing") read it as
				 * B1P30 (the PWM4 pad), low = pressed. */
				snooze_pins: snooze@0 {
					reg = <0>;
					fsl,pinmux-ids = <
						MX23_PAD_PWM4__GPIO_1_30
					>;
					fsl,drive-strength = <MXS_DRIVE_4mA>;
					fsl,voltage = <MXS_VOLTAGE_HIGH>;
					fsl,pull-up = <MXS_PULL_ENABLE>;
				};
			};
		};

		apbx-bus@80040000 {
			/* I2C0 on the dedicated I2C_SCL/SDA pads (B0P30/31):
			 * QN8005 FM tuner at 0x2b (7-bit), plus the accelerometer. */
			/* The I2C block can't do the tuner's reads: see i2c_gpio. */
			i2c: i2c@80058000 {
				status = "disabled";
			};

			usbphy0: usbphy@8007c000 {
				status = "okay";
			};

			/* 4-wire resistive touchscreen on LRADC (vendor: X+ ch2,
			 * Y+ ch3), plus the general-purpose ADC channels.
			 * Settling and averaging above the driver's defaults (5 ms,
			 * 4 samples): with those, a press often began or ended on
			 * a half-scale reading (plate not yet/no longer in contact),
			 * a jump to mid-screen that sent the tap to the wrong window. */
			lradc@80050000 {
				fsl,lradc-touchscreen-wires = <4>;
				fsl,settling = <20>;	/* 0.5 ms units: 10 ms */
				fsl,ave-ctrl = <8>;
				status = "okay";
			};

			/*
			 * Built-in codec (AUDIOOUT + AUDIOIN), driven by the
			 * board's imx23-audio patch. DAI 0 = CPU, DAI 1 = codec.
			 * The FM tuner's output is wired to LINE1.
			 */
			audio: audio-out@80048000 {
				compatible = "fsl,imx23-audio";
				reg = <0x80048000 0x2000>, <0x8004c000 0x2000>,
				      <0x8005c000 0x2000>;
				reg-names = "audioout", "audioin", "rtc";
				clocks = <&clks 31>;
				clock-names = "filt";
				dmas = <&dma_apbx 0>, <&dma_apbx 1>;
				dma-names = "rx", "tx";
				#sound-dai-cells = <1>;
				status = "okay";
			};

			/* PWM2 (B1P28): backlight. */
			pwm: pwm@80064000 {
				pinctrl-names = "default";
				pinctrl-0 = <&pwm2_pins_a>;
				status = "okay";
			};

			/* DUART on PWM0/PWM1: the 115200 8N1 debug header. */
			duart: serial@80070000 {
				pinctrl-names = "default";
				pinctrl-0 = <&duart_pins_a>;
				status = "okay";
			};
		};
	};

	ahb@80080000 {
		/* Host-only port: internal hub with the wifi module and the
		 * external USB socket. */
		usb0: usb@80080000 {
			dr_mode = "host";
			vbus-supply = <&reg_usb_vbus>;
			status = "okay";
		};
	};

	panel {
		compatible = "chumby,falconwing-lcd";
		backlight = <&backlight>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&lcdif_out>;
			};
		};
	};

	/*
	 * Vendor: 24 MHz / 64 / 600 = 625 Hz, active high. Levels: the panel
	 * is barely readable at 16 % duty (checked on hardware; 7 % is not),
	 * so level 1 starts there and each step is ~18 % brighter. Off is
	 * bl_power, not level 0.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 2 1600000 0>;
		brightness-levels = <0 16 19 22 26 31 36 43 51 60 71 84 100>;
		default-brightness-level = <10>;
	};

	sound {
		compatible = "simple-audio-card";
		simple-audio-card,name = "Chumby One";
		simple-audio-card,widgets =
			"Speaker", "Speaker",
			"Headphone", "Headphones",
			"Line", "FM Tuner";
		simple-audio-card,routing =
			"Speaker Amp INL", "SPEAKER",
			"Speaker Amp INR", "SPEAKER",
			"Speaker", "Speaker Amp OUTL",
			"Speaker", "Speaker Amp OUTR",
			"Headphones", "HPL",
			"Headphones", "HPR",
			"LINE1L", "FM Tuner",
			"LINE1R", "FM Tuner";
		simple-audio-card,hp-det-gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
		simple-audio-card,aux-devs = <&speaker_amp>;

		simple-audio-card,cpu {
			sound-dai = <&audio 0>;
		};

		simple-audio-card,codec {
			sound-dai = <&audio 1>;
		};
	};

	/* External speaker amplifier behind the codec's speaker output
	 * (vendor stmp3xxx_dai.c: B0P8 high = muted). */
	speaker_amp: audio-amplifier {
		compatible = "simple-audio-amplifier";
		enable-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
		sound-name-prefix = "Speaker Amp";
	};

	/*
	 * I2C0 on the dedicated I2C_SCL/SDA pads, bit-banged: QN8005 FM
	 * tuner at 0x2b (7-bit), MMA7455 accelerometer at 0x1d, EEPROM.
	 * The tuner's register read is not standard I2C: START, address with
	 * the read bit, the register number written, then the data read, with
	 * no repeated start (the vendor kernel special-cased it). Only the
	 * bit-banging algorithm can do that (I2C_M_REV_DIR_ADDR +
	 * I2C_M_NOSTART); i2c-mxs NAKs. ~100 kHz.
	 */
	i2c_gpio: i2c {
		compatible = "i2c-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_gpio_pins>;
		sda-gpios = <&gpio0 31 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		scl-gpios = <&gpio0 30 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		i2c-gpio,delay-us = <5>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	rotary {
		compatible = "rotary-encoder";
		pinctrl-names = "default";
		pinctrl-0 = <&rotary_pins>;
		gpios = <&gpio2 7 GPIO_ACTIVE_HIGH>, <&gpio2 8 GPIO_ACTIVE_HIGH>;
		linux,axis = <REL_WHEEL>;	/* what the vendor rotdec reported */
		rotary-encoder,relative-axis;
	};

	/* The vendor driver reported KEY_ENTER; the shell finds the device by
	 * its "snooze" name, and chumby-wm keeps it away from apps. */
	gpio-keys {
		compatible = "gpio-keys";
		label = "snooze";
		pinctrl-names = "default";
		pinctrl-0 = <&snooze_pins>;

		button-snooze {
			label = "Snooze";
			gpios = <&gpio1 30 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_PROG1>;
			debounce-interval = <20>;
		};
	};

	/*
	 * B0P26 high powers the USB port/hub (vendor ehci-arc power-cycles it
	 * low -> high before probing, which also helps the wifi enumerate).
	 * Not boot-on, so the regulator core reproduces that power cycle.
	 */
	reg_usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb_vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 26 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <100000>;
	};
};

&gpio0 {
	local-5v-on-hog {
		gpio-hog;
		gpios = <12 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "local-5v-on";
	};

	usb-reset-hog {
		gpio-hog;
		gpios = <29 GPIO_ACTIVE_LOW>;
		output-low;	/* deasserted */
		line-name = "usb-reset-n";
	};
};

&gpio1 {
	/* Keep the panel out of reset: the bootloader initialised it and
	 * mxsfb's LCDIF block reset would otherwise drive LCD_RESET low. */
	lcd-reset-hog {
		gpio-hog;
		gpios = <18 GPIO_ACTIVE_LOW>;
		output-low;	/* deasserted */
		line-name = "lcd-reset-n";
	};
};

&{/cpus/cpu@0} {
	clocks = <&clks 11>;	/* "cpu" */
	operating-points-v2 = <&cpu_opp_table>;
};
