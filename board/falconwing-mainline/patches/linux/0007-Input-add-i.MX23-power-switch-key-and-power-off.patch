From: falconwing bring-up
Subject: [PATCH] Input: add an i.MX23 power switch key and power-off driver

The Chumby One's power button is the i.MX23's PSWITCH, whose level the
power block reports in HW_POWER_STS; mainline has no driver for it, nor a
way to power the chip off (so "poweroff" halted and the bootloader-armed
watchdog rebooted the board). Poll PSWITCH as KEY_POWER ("mxs-pswitch")
and power off through HW_POWER_RESET.

---
diff -urN a/drivers/input/misc/Kconfig b/drivers/input/misc/Kconfig
--- a/drivers/input/misc/Kconfig	2026-10-11 01:47:58.187408500 -0700
+++ b/drivers/input/misc/Kconfig	2026-10-11 01:48:37.013055551 -0700
@@ -271,6 +271,17 @@
 	  To compile this driver as a module, choose M here: the module
 	  will be called max77650-onkey.
 
+config INPUT_MXS_PSWITCH
+	tristate "Freescale i.MX23 power switch and power-off"
+	depends on ARCH_MXS || COMPILE_TEST
+	depends on OF
+	help
+	  Report the i.MX23 power switch (PSWITCH) as KEY_POWER, and power
+	  the chip off through its power block.
+
+	  To compile this driver as a module, choose M here: the module
+	  will be called mxs-pswitch.
+
 config INPUT_MAX77693_HAPTIC
 	tristate "MAXIM MAX77693/MAX77705/MAX77843 haptic controller support"
 	depends on (MFD_MAX77693 || MFD_MAX77705 || MFD_MAX77843) && PWM
diff -urN a/drivers/input/misc/Makefile b/drivers/input/misc/Makefile
--- a/drivers/input/misc/Makefile	2026-10-11 01:47:58.187451661 -0700
+++ b/drivers/input/misc/Makefile	2026-10-11 01:48:37.013092290 -0700
@@ -55,6 +55,7 @@
 obj-$(CONFIG_INPUT_MAX7360_ROTARY)	+= max7360-rotary.o
 obj-$(CONFIG_INPUT_MAX77650_ONKEY)	+= max77650-onkey.o
 obj-$(CONFIG_INPUT_MAX77693_HAPTIC)	+= max77693-haptic.o
+obj-$(CONFIG_INPUT_MXS_PSWITCH)	+= mxs-pswitch.o
 obj-$(CONFIG_INPUT_MAX8925_ONKEY)	+= max8925_onkey.o
 obj-$(CONFIG_INPUT_MAX8997_HAPTIC)	+= max8997_haptic.o
 obj-$(CONFIG_INPUT_MC13783_PWRBUTTON)	+= mc13783-pwrbutton.o
diff -urN a/drivers/input/misc/mxs-pswitch.c b/drivers/input/misc/mxs-pswitch.c
--- a/drivers/input/misc/mxs-pswitch.c	1969-12-31 16:00:00.000000000 -0800
+++ b/drivers/input/misc/mxs-pswitch.c	2026-10-11 01:48:37.012951435 -0700
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * i.MX23 power switch (PSWITCH) as KEY_POWER, and power-off.
+ *
+ * The power block's HW_POWER_STS reports the PSWITCH pin's level (bits
+ * 21:20, non-zero while pressed); there is no mainline driver for it, so
+ * it's polled here. Powering off is a write to HW_POWER_RESET (the unlock
+ * key and PWD): without it, "poweroff" only halts, and the watchdog the
+ * bootloader armed reboots the board.
+ */
+
+#include <linux/delay.h>
+#include <linux/input.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/reboot.h>
+
+#define HW_POWER_STS		0xc0
+#define  STS_PSWITCH_SHIFT	20
+#define  STS_PSWITCH_MASK	0x3
+#define HW_POWER_RESET		0x100
+#define  RESET_UNLOCK_KEY	(0x3e77 << 16)
+#define  RESET_PWD		BIT(0)
+
+#define POLL_MS			50
+
+struct mxs_pswitch {
+	void __iomem *base;
+	struct input_dev *input;
+};
+
+static void mxs_pswitch_poll(struct input_dev *input)
+{
+	struct mxs_pswitch *p = input_get_drvdata(input);
+	u32 sts = readl(p->base + HW_POWER_STS);
+
+	input_report_key(input, KEY_POWER,
+			 (sts >> STS_PSWITCH_SHIFT) & STS_PSWITCH_MASK);
+	input_sync(input);
+}
+
+static int mxs_pswitch_power_off(struct sys_off_data *data)
+{
+	struct mxs_pswitch *p = data->cb_data;
+
+	writel(RESET_UNLOCK_KEY | RESET_PWD, p->base + HW_POWER_RESET);
+	mdelay(1000);
+	return NOTIFY_DONE;
+}
+
+static int mxs_pswitch_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct mxs_pswitch *p;
+	int ret;
+
+	p = devm_kzalloc(dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(p->base))
+		return PTR_ERR(p->base);
+
+	p->input = devm_input_allocate_device(dev);
+	if (!p->input)
+		return -ENOMEM;
+	p->input->name = "mxs-pswitch";
+	p->input->phys = "mxs-pswitch/input0";
+	p->input->id.bustype = BUS_HOST;
+	input_set_capability(p->input, EV_KEY, KEY_POWER);
+	input_set_drvdata(p->input, p);
+
+	ret = input_setup_polling(p->input, mxs_pswitch_poll);
+	if (ret)
+		return ret;
+	input_set_poll_interval(p->input, POLL_MS);
+	ret = input_register_device(p->input);
+	if (ret)
+		return ret;
+
+	return devm_register_sys_off_handler(dev, SYS_OFF_MODE_POWER_OFF,
+					     SYS_OFF_PRIO_DEFAULT,
+					     mxs_pswitch_power_off, p);
+}
+
+static const struct of_device_id mxs_pswitch_of_match[] = {
+	{ .compatible = "fsl,imx23-power" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, mxs_pswitch_of_match);
+
+static struct platform_driver mxs_pswitch_driver = {
+	.probe = mxs_pswitch_probe,
+	.driver = {
+		.name = "mxs-pswitch",
+		.of_match_table = mxs_pswitch_of_match,
+	},
+};
+module_platform_driver(mxs_pswitch_driver);
+
+MODULE_DESCRIPTION("i.MX23 power switch key and power-off");
+MODULE_LICENSE("GPL");
