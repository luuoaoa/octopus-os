#!/bin/sh
# Try builds on a Chumby One without reflashing it, and measure.
#
#   bin/chumby-try HOST push PATH...   stage this build's PATH (e.g.
#                     /usr/bin/chumby-wm, /usr/lib/libchumby.so.1) for the
#                     Chumby's run overlay: an unstripped copy (named
#                     functions in perf) on its SD card, /var/try/root,
#                     which /var/run-overlay binds over the read-only image
#                     at the next boot (board/.../carrier/sbin/init-ram)
#   bin/chumby-try HOST apply          reboot into it (and wait)
#   bin/chumby-try HOST status         the overlay: armed or not, its files,
#                     its last log. (An update - bin/update-chumby.sh, or any
#                     new image - ends it; chumby-wm frames the screen in
#                     magenta while anything is bound over the image.)
#   bin/chumby-try HOST reset          the overlay gone, reboot: the image's
#   bin/chumby-try HOST restart        restart the UI session
#   bin/chumby-try HOST perf [S]       S seconds (default 10) of the whole
#                     system sampled (perf, on the timer), the busiest
#                     functions by process and library
#   bin/chumby-try HOST bench [NAME...] CPU per process and the system's
#                     load in scenarios (default: all): idle (the clock in
#                     front), saver (over FM Radio), stream (Internet
#                     Radio playing, the clock in front), podcast (playing,
#                     Podcasts in front), saver-stream (the saver over a
#                     stream). The screen is lit first, and the sound muted
#                     (the DAC at 0) and left so: nothing is heard.
#
# The overlay is the escape hatch: init-ram disables it before running it
# (a boot it breaks comes back as the image's) and chumby-overlay-ok
# re-arms it after a boot that went well. Nothing is swapped under a
# running session (that reset the Chumby: its 64 MB, the watchdog). Load is
# shares of the ticks counted, not of wall time: this kernel counts fewer
# ticks than pass while idle. Key auth, else password "root"
# (CHUMBY_SSH_PASSWORD), as bin/update-chumby.sh.
set -eu

HOST="${1:-}"
CMD="${2:-}"
[ -n "$HOST" ] && [ -n "$CMD" ] || { sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2; exit 2; }
shift 2
case "$HOST" in *@*) ;; *) HOST="root@${HOST}" ;; esac

TOP="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${TOP}/output-falconwing-mainline"
# On the Chumby, all on its SD card (/var: the carrier's /data/var), never
# /tmp (RAM). The overlay's files under root/, as in the image.
TRY=/var/try

SSH_CTL="${TMPDIR:-/tmp}/chumby-try-$$.sock"
SSH_OPTS="-o ControlMaster=auto -o ControlPath=${SSH_CTL} -o ControlPersist=60s \
-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null \
-o GlobalKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=30"
on() { ssh ${SSH_OPTS} "${HOST}" "$@"; }
login() {
	if ! SSH_ASKPASS_REQUIRE=never ssh ${SSH_OPTS} -o BatchMode=yes "${HOST}" true 2>/dev/null; then
		command -v sshpass >/dev/null 2>&1 || { echo "key auth failed and sshpass is not installed" >&2; exit 1; }
		SSH_ASKPASS_REQUIRE=never sshpass -p "${CHUMBY_SSH_PASSWORD:-root}" \
			ssh ${SSH_OPTS} -o PubkeyAuthentication=no "${HOST}" true
	fi
}
trap 'ssh ${SSH_OPTS} -O exit "${HOST}" 2>/dev/null || true; rm -f "${SSH_CTL}"' EXIT
login

# This build's unstripped copy of a target path: the sysroot has the
# libraries as built, a package's build directory its programs.
unstripped() {
	# (staging links to the build container's /work path: the sysroot.)
	for sysroot in "${OUT}"/host/*-linux-*/sysroot; do
		if [ -f "${sysroot}$1" ]; then
			echo "${sysroot}$1"
			return
		fi
	done
	find "${OUT}/build" -name "$(basename "$1")" -type f -perm -u+x \
		-not -name '.*' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-
}

# Back up after a reboot: SSH again, the session running a while.
wait_up() {
	sleep 20
	ssh ${SSH_OPTS} -O exit "${HOST}" 2>/dev/null || true
	i=0
	until ssh ${SSH_OPTS} -o BatchMode=yes "${HOST}" \
		'test $(cut -d. -f1 /proc/uptime) -gt 40 && systemctl is-active -q chumby-session' 2>/dev/null; do
		i=$((i + 1))
		[ $i -lt 40 ] || { echo "${HOST}: not back after a reboot" >&2; exit 1; }
		sleep 5
	done
}

case "$CMD" in
push)
	for p in "$@"; do
		src=$(unstripped "$p")
		[ -n "$src" ] || { echo "no build of $p under ${OUT}" >&2; exit 1; }
		on "mkdir -p ${TRY}/root$(dirname "$p") && cat > ${TRY}/root$p.new &&
		    chmod 755 ${TRY}/root$p.new && mv ${TRY}/root$p.new ${TRY}/root$p" < "$src"
		echo "staged $p <- ${src#${TOP}/} ($(du -h "$src" | cut -f1))"
	done
	# The overlay: every staged file bound over the image's, in the early
	# boot (where the card is /, $ROOT the image).
	on "cd ${TRY}/root && {
		echo '# Written by bin/chumby-try: the files under /var/try/root over the image.'
		echo \"# image-inode: \$(ls -i /media/sd/rootfs.squashfs | sed 's/^ *\\([0-9]*\\).*/\\1/')\"
		echo '# (init-ram runs it only on that image: an update makes it stale.)'
		find . -type f | sed 's|^\./||' | while read -r f; do
			echo \"mount --bind /data${TRY}/root/\$f \\\$ROOT/\$f\"
		done
	    } > /var/run-overlay.new && mv /var/run-overlay.new /var/run-overlay && rm -f /var/run-overlay.disabled &&
	    echo \"run overlay: \$(grep -c '^mount' /var/run-overlay) file(s), at the next boot (apply)\""
	;;
apply)
	on 'amixer -q sset DAC 0 mute 2>/dev/null; sync; reboot' || true
	wait_up
	on "echo \"up \$(cut -d' ' -f1 /proc/uptime) s; overlay:\"; grep ' /usr/' /proc/mounts | cut -d' ' -f2;
	    [ -s /var/run-overlay.log ] && { echo '-- its log:'; cat /var/run-overlay.log; };
	    amixer -q sset DAC 0 mute 2>/dev/null; true"
	;;
status)
	on "if [ -e /var/run-overlay ]; then echo 'armed: /var/run-overlay'
	    elif [ -e /var/run-overlay.stale ]; then echo 'stale: made for another image (updated since), not run'
	    elif [ -e /var/run-overlay.disabled ]; then
		[ -e /var/run-overlay.applied ] && echo 'running, re-arms once this boot has gone well' ||
		    echo 'disabled (a boot it ran in did not finish well): push again to re-arm'
	    else echo 'none'; fi
	    echo '-- bound now:'; grep ' /usr/' /proc/mounts | cut -d' ' -f2
	    [ -s /var/run-overlay.log ] && { echo '-- last log:'; cat /var/run-overlay.log; }; true"
	;;
reset)
	on "rm -rf ${TRY}/root /var/run-overlay /var/run-overlay.disabled /var/run-overlay.applied /var/run-overlay.log
	    amixer -q sset DAC 0 mute 2>/dev/null; sync; reboot" || true
	wait_up
	echo "back on the image's files ($(on "grep -c ' /usr/' /proc/mounts" || true) bound)"
	;;
restart)
	on 'systemctl restart chumby-session && echo "session restarted"'
	;;
perf)
	secs="${1:-10}"
	on "mkdir -p ${TRY} && perf record -a -F 250 -o ${TRY}/perf.data -q -- sleep ${secs} 2>/dev/null &&
	    echo '-- by process and library:' &&
	    perf report -i ${TRY}/perf.data --stdio --sort comm,dso --percent-limit 0.5 2>/dev/null |
	    grep -v '^#' | grep -v '^$' | head -25 &&
	    echo '-- busiest functions (idle left out):' &&
	    perf report -i ${TRY}/perf.data --stdio --sort comm,dso,sym 2>/dev/null |
	    grep -v '^#' | grep -v '^$' | grep -v default_idle_call | head -30; rm -f ${TRY}/perf.data"
	;;
bench)
	on "mkdir -p ${TRY} && TRY=${TRY} SCENARIOS='$*' sh -s" <<'EOF'
export XDG_RUNTIME_DIR=/run/chumby WAYLAND_DISPLAY=wayland-0
C=/run/chumby/shell.cmd
T=15
STATION=$(grep -v '^[#[]' /usr/share/chumby/streams.conf | grep -m1 '|' | cut -d'|' -f2 | tr -d ' ')
EPISODE=$(head -1 "$(ls /var/lib/chumby/podcasts/*.feed 2>/dev/null | head -1)" 2>/dev/null | cut -f4)

snap() {	# pid ticks name
	for p in /proc/[0-9]*; do
		awk '{ c = $2; for (i = 3; i <= NF && c !~ /\)$/; i++) c = c " " $i;
		       print $1, $(i + 11) + $(i + 12), c }' $p/stat 2>/dev/null
	done
}
ticks() { awk '/^cpu / { s = 0; for (i = 2; i <= 9; i++) s += $i; print s, $5 + $6 }' /proc/stat; }
measure() {
	snap > $TRY/b0; set -- $(ticks); t0=$1 i0=$2
	sleep $T
	snap > $TRY/b1; set -- $(ticks); t1=$1 i1=$2
	tot=$((t1 - t0))
	echo "== $SC: busy $(( (tot - (i1 - i0)) * 100 / tot ))%"
	awk -v T=$tot 'NR == FNR { a[$1] = $2; next }
	     ($1 in a) && ($2 - a[$1]) * 100 / T >= 1 { printf "   %3d%% %s\n", ($2 - a[$1]) * 100 / T, substr($0, index($0, $3)) }' \
		$TRY/b0 $TRY/b1 | sort -rn | head -6
}
# Silent: the codec's DAC (the UI's volume) muted at 0 and left so; again
# after anything starts playing (a player may set its level).
mute() { amixer -q sset DAC 0 mute 2>/dev/null; }
quiet() { echo active > $C; chumby-stream stop 2>/dev/null; radio off >/dev/null 2>&1; mute; }
# The screen on (the snooze button's way: past the screen-off hours too):
# a dark screen gets no saver, and draws nothing.
lit() { [ "$(cat /sys/class/backlight/backlight/bl_power 2>/dev/null)" = 0 ] || { echo snooze > $C; sleep 2; }; }
mute
lit
front() { echo "launch $1" > $C; sleep ${2:-12}; }
saver() {
	echo idle > $C; sleep 4
	[ -n "$(pidof chumby-toasters)" ] || echo "   (no saver: see the journal, \"no screen saver: ...\")"
}

[ -n "$SCENARIOS" ] || SCENARIOS="idle saver stream podcast saver-stream"
for SC in $SCENARIOS; do
	quiet
	case $SC in
	idle)	front Clock; measure ;;
	saver)	front "FM Radio"; saver; measure ;;
	stream)	chumby-stream "$STATION" Bench 2>/dev/null; mute; front Clock 15; mute; measure ;;
	podcast)
		kill $(pidof chumby-podcasts) 2>/dev/null
		chumby-stream "$EPISODE" Bench 10000000 2>/dev/null; mute; sleep 3
		front Podcasts 15; mute; measure ;;
	saver-stream)
		chumby-stream "$STATION" Bench 2>/dev/null; mute; front "FM Radio" 15; mute; saver; measure ;;
	*)	echo "== $SC: unknown" ;;
	esac
done 2>&1 | grep -v "ALSA lib"
quiet
echo "launch Clock" > $C
rm -f $TRY/b0 $TRY/b1
EOF
	;;
*)
	echo "unknown command: $CMD" >&2
	exit 2
	;;
esac
