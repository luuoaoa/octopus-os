#!/bin/sh
#
# Start the Wayland session: chumby-wm with chumby-shell.
#

DAEMON=/usr/bin/chumby-wm
PIDFILE=/var/run/chumby-session.pid
LOG=/var/log/chumby-session.log

start() {
	printf "Starting chumby session: "
	# mxsfb (the display) is a module loaded by udev: wait for it.
	i=0
	while [ ! -e /dev/dri/card0 ] && [ $i -lt 15 ]; do
		sleep 1
		i=$((i + 1))
	done
	if [ ! -e /dev/dri/card0 ]; then
		echo "FAIL (no /dev/dri/card0)"
		return 1
	fi
	mkdir -p /run/chumby
	chmod 0700 /run/chumby
	# Runs as root on the console; libseat's builtin backend opens the
	# DRM and input devices directly. No GPU: wlroots' pixman renderer.
	XDG_RUNTIME_DIR=/run/chumby \
	LIBSEAT_BACKEND=builtin \
	WLR_RENDERER=pixman \
	WLR_LIBINPUT_NO_DEVICES=1 \
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x /bin/sh -- -c \
		"exec $DAEMON -s /usr/bin/chumby-shell >$LOG 2>&1" \
		&& echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping chumby session: "
	start-stop-daemon -K -q -p "$PIDFILE" && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE"
	# Apps exit when the compositor goes; make sure of it.
	for exe in /usr/bin/chumby-shell /usr/bin/chumby-alarm-tone \
		   $(sed -n 's/^Exec *= *//p' /usr/share/chumby/apps/*.app 2>/dev/null); do
		start-stop-daemon -K -q -x "$exe" 2>/dev/null
	done
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; sleep 1; start ;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
