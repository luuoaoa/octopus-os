#!/bin/sh
# octopus-station-art <MHz>: name the FM station on <MHz> here and fetch its
# logo, for octopus-fm.
#
#   1. where we are: "location: <lat>,<lon>" in the config partition's
#      user-data (-> /run/octopus-config/location), else one IP geolocation
#      lookup (ipinfo.io), cached in $ART/location
#   2. which station: the FCC's licensed FM stations on <MHz>, nearest
#      transmitter (US only)
#   3. its logo: the "logo" of the station's Wikipedia infobox, as a
#      120 px PNG or JPEG
#
# Results go to $ART/<MHz>.info (call=, city=, logo=) and the
# logo as $ART/<MHz>.png or .jpg (LVGL picks the decoder by extension).
# Lookups that found nothing are remembered too (call= empty), and retried
# after a month; network failures after an hour. Prints the .info path.
set -u

ART=${OCTOPUS_ART_DIR:-/var/lib/octopus/art}
UA="octopus-station-art/1.0 (Chumby One; +https://github.com/luuoaoa/octopus-os)"
MHZ=$(printf '%.1f' "${1:?usage: octopus-station-art <MHz>}")
INFO="$ART/$MHZ.info"
IMG="$ART/$MHZ.img"

mkdir -p "$ART"
# curl's mbed TLS can't use the certificate directory, only the bundle.
[ -r /etc/ssl/certs/ca-certificates.crt ] &&
	export CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
get() { curl -fsSL -m 20 -A "$UA" "$@"; }
fail() {
	# Try again in an hour (the network may just not be up yet).
	printf 'call=\nretry=%s\n' "$(($(date +%s) + 3600))" > "$INFO"
	echo "octopus-station-art: $*" >&2
	exit 1
}

# --- where we are ---
LOC=
[ -r /run/octopus-config/location ] && LOC=$(cat /run/octopus-config/location)
if [ -z "$LOC" ]; then
	[ -s "$ART/location" ] ||
		get https://ipinfo.io/json | jq -r '.loc // empty' > "$ART/location.new" &&
		[ -s "$ART/location.new" ] && mv "$ART/location.new" "$ART/location"
	LOC=$(cat "$ART/location" 2>/dev/null)
fi
case "$LOC" in *,*) ;; *) fail "no location";; esac

# --- which station: nearest licensed transmitter on this frequency ---
# FCC fmq text: |call|freq|...|city|state|...|N|deg|min|sec|W|deg|min|sec|
FCC=$(get "https://transition.fcc.gov/fcc-bin/fmq?freq=$MHZ&fre2=$MHZ&serv=FM&status=LIC&list=4&size=9") ||
	fail "FCC lookup failed"
STATION=$(printf '%s\n' "$FCC" | awk -F'|' -v loc="$LOC" '
	function trim(s) { gsub(/^ +| +$/, "", s); return s }
	function title(s,   out, n, i, w) {	# SAN FRANCISCO -> San Francisco
		n = split(tolower(s), w, " ")
		for (i = 1; i <= n; i++)
			out = out (i > 1 ? " " : "") toupper(substr(w[i], 1, 1)) substr(w[i], 2)
		return out
	}
	# busybox awk has no math functions: cos() by its Taylor series (it
	# only scales longitude by latitude, a few digits are plenty).
	function cosine(x,   x2) { x2 = x * x; return 1 - x2 / 2 + x2 * x2 / 24 - x2 * x2 * x2 / 720 }
	BEGIN { split(loc, h, ","); best = -1; pi = 3.14159265 }
	NF > 27 {
		lat = $21 + $22 / 60 + $23 / 3600; if (trim($20) == "S") lat = -lat
		lon = $25 + $26 / 60 + $27 / 3600; if (trim($24) == "W") lon = -lon
		dx = (lon - h[2]) * cosine(h[1] * pi / 180); dy = lat - h[1]
		d = dx * dx + dy * dy
		if (best < 0 || d < best) { best = d; call = trim($2); city = title(trim($11)) }
	}
	END { if (best >= 0 && best < 4) print call "|" city }')	# within ~200 km
CALL=${STATION%%|*}
CITY=${STATION#*|}

# --- its logo, from the Wikipedia infobox ---
LOGO=
api() { get "https://en.wikipedia.org/w/api.php?format=json&$1"; }
if [ -n "$CALL" ]; then
	base=${CALL%-FM}
	for title in "$CALL" "$base-FM" "$base (FM)" "$base"; do
		t=$(printf '%s' "$title" | sed 's/ /%20/g; s/(/%28/g; s/)/%29/g')
		file=$(api "action=query&prop=revisions&rvprop=content&rvslots=main&rvsection=0&redirects=1&titles=$t" |
			jq -r '.query.pages[].revisions[0].slots.main["*"] // empty' |
			sed -n 's/^ *| *logo *= *\(\[\[\)\{0,1\}\(File:\|Image:\)\{0,1\}\([^]|]*\).*/\3/p' | head -n 1)
		[ -n "$file" ] || continue
		f=$(printf '%s' "File:$file" | sed 's/ /%20/g')
		url=$(api "action=query&prop=imageinfo&iiprop=url&iiurlwidth=120&titles=$f" |
			jq -r '.query.pages[].imageinfo[0].thumburl // empty')
		if [ -n "$url" ] && get -o "$IMG.new" "$url"; then
			case $(head -c 4 "$IMG.new" | od -An -tx1 | tr -d ' \n') in
			89504e47) ext=png ;;
			ffd8ff*) ext=jpg ;;
			*) ext= ;;
			esac
			if [ -n "$ext" ]; then
				rm -f "$ART/$MHZ.png" "$ART/$MHZ.jpg"
				LOGO="$ART/$MHZ.$ext"
				mv "$IMG.new" "$LOGO"
				break
			fi
		fi
		rm -f "$IMG.new"
	done
fi

{
	echo "call=$CALL"
	echo "city=$CITY"
	echo "logo=$LOGO"
	[ -n "$LOGO" ] || echo "retry=$(($(date +%s) + 30 * 86400))"
} > "$INFO.new" && mv "$INFO.new" "$INFO"
echo "$INFO"
