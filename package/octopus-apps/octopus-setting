#!/bin/sh
# octopus-setting: the settings only root may change, for the Settings app
# (which runs as the apps' user): octopus-shell runs this, as root, for its
# "setting ..." command.
#
#   octopus-setting ssh on|off        the SSH server; the first time on, a
#                                    random 8-character root password
#   octopus-setting timezone AREA/CITY
#
# Kept in /var/lib/octopus-root (root's; the apps' group may read): "ssh"
# (on|off), "ssh-password" (to show it), "root.hash", "timezone".
# sdcard-config-apply applies them at every boot, over the config
# partition's user-data. Applied now too.
set -eu

STATE=/var/lib/octopus-root
RUN=/run/octopus-config

[ "$(id -u)" = 0 ] || { echo "octopus-setting: run as root" >&2; exit 1; }
install -d -o root -g octopus -m 0750 "$STATE"

case "${1:-} ${2:-}" in
"ssh on")
	if [ ! -s "$STATE/ssh-password" ] || [ ! -s "$STATE/root.hash" ]; then
		pw=$(tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' < /dev/urandom | head -c 8)
		mkpasswd -m sha512 "$pw" > "$STATE/root.hash"
		chmod 600 "$STATE/root.hash"
		printf '%s\n' "$pw" > "$STATE/ssh-password"
		chown root:octopus "$STATE/ssh-password"
		chmod 640 "$STATE/ssh-password"
	fi
	hash=$(cat "$STATE/root.hash")
	awk -F: -v OFS=: -v h="$hash" '$1 == "root" { $2 = h } 1' "$RUN/shadow" > "$RUN/shadow.new"
	chmod 600 "$RUN/shadow.new"
	mv "$RUN/shadow.new" "$RUN/shadow"
	echo on > "$STATE/ssh"
	echo 'DROPBEAR_ARGS=""' > "$RUN/dropbear"	# the password logs in
	touch "$RUN/ssh-on"
	systemctl start dropbear
	;;
"ssh off")
	echo off > "$STATE/ssh"
	rm -f "$RUN/ssh-on"
	systemctl stop dropbear
	;;
timezone\ *)
	tz=${2:-}
	case "$tz" in *..* | /* | "") echo "octopus-setting: bad time zone" >&2; exit 2 ;; esac
	[ -f "/usr/share/zoneinfo/$tz" ] || { echo "octopus-setting: no time zone $tz" >&2; exit 2; }
	echo "$tz" > "$STATE/timezone"
	ln -sf "/usr/share/zoneinfo/$tz" "$RUN/localtime"
	echo "$tz" > "$RUN/timezone"
	;;
*)
	sed -n '2,/^$/s/^# \{0,1\}//p' "$0" >&2
	exit 2
	;;
esac
