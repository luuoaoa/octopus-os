[Unit]
Description=onlyfansd — HomeKit/HA bridge for Casa Vieja TR301A ceiling fans (rpitx)
# Reads /boot/onlyfansd.yaml. The pi-imager-apply ordering ensures /boot is
# mounted before us; ConditionPathExists keeps us silent until the user
# drops a config file on the FAT.
After=network-online.target pi-imager-apply.service
Wants=network-online.target
ConditionPathExists=/boot/onlyfansd.yaml

[Service]
Type=simple
ExecStart=/usr/bin/onlyfansd /boot/onlyfansd.yaml
Restart=on-failure
RestartSec=10
# /var/lib/onlyfansd is created on each start (lives on the persistent
# /var partition, so daemon state survives reboots).
StateDirectory=onlyfansd
WorkingDirectory=/var/lib/onlyfansd

[Install]
WantedBy=multi-user.target
