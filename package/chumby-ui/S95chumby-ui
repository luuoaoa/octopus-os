#!/bin/sh
#
# Start the LVGL home screen on the LCD.
#

DAEMON=/usr/bin/chumby-ui
PIDFILE=/var/run/chumby-ui.pid

case "$1" in
  start)
	printf "Starting chumby-ui: "
	start-stop-daemon -S -q -b -m -p "$PIDFILE" -x "$DAEMON" \
		&& echo "OK" || echo "FAIL"
	;;
  stop)
	printf "Stopping chumby-ui: "
	start-stop-daemon -K -q -p "$PIDFILE" && echo "OK" || echo "FAIL"
	rm -f "$PIDFILE"
	;;
  restart)
	"$0" stop
	sleep 1
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac
