config BR2_PACKAGE_LIBCHUMBY
	bool "libchumby"
	depends on BR2_TOOLCHAIN_HAS_THREADS # alsa-lib, wayland
	depends on !BR2_STATIC_LIBS # wayland
	select BR2_PACKAGE_LVGL
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_FONT_NOTO_SANS
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_MIXER
	help
	  Common framework for Chumby One apps: LVGL on Wayland, Noto
	  Sans via FreeType, the universal dark theme with automatic night
	  mode (/etc/chumby/policy.conf), volume/brightness/screen
	  helpers, alarms.
