# libchumby: LVGL (unpacked into ./lvgl by the package) + the framework,
# as one shared library. The package passes PKG_CONFIG, WAYLAND_SCANNER
# and WAYLAND_PROTOCOLS.
PKG_CONFIG ?= pkg-config
PKGS := wayland-client wayland-cursor xkbcommon alsa pixman-1
SONAME := libchumby.so.1

LVGL_PATH := lvgl
PROTO_SRCS := wayland_xdg_shell.c wayland_xdg_output.c wayland_screencopy.c
PROTO_HDRS := $(PROTO_SRCS:.c=.h)
# Nimbus bitmap fonts (BDF from Rockbox), converted at build time:
# name = file, scale. The clock face is the 35 px font doubled; the FM
# frequency the 14 px one (Rockbox has nothing between 19 and 35).
FONTS := nimbus_12 nimbus_14 nimbus_19 nimbus_35 nimbus_35x2 nimbus_14x2
FONT_SRCS := $(FONTS:=.c)
# Icon fonts: generated by fonts/icons2lvgl.py and committed (no PIL here).
ICON_SRCS := chumby_icons_14.c chumby_icons_20.c chumby_icons_28.c chumby_icons_42.c
CSRCS := $(shell find $(LVGL_PATH)/src -type f -name '*.c') chumby.c saver.c $(PROTO_SRCS) \
	$(FONT_SRCS) $(ICON_SRCS)
OBJS := $(CSRCS:.c=.o)

override CFLAGS += -fPIC -Wall -DLV_CONF_INCLUDE_SIMPLE -I. -I$(LVGL_PATH) \
	$(shell $(PKG_CONFIG) --cflags $(PKGS))
LDLIBS += $(shell $(PKG_CONFIG) --libs $(PKGS)) -lm

all: $(SONAME)

wayland_xdg_shell.h:
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/stable/xdg-shell/xdg-shell.xml $@
wayland_xdg_shell.c:
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/stable/xdg-shell/xdg-shell.xml $@
wayland_xdg_output.h:
	$(WAYLAND_SCANNER) client-header $(WAYLAND_PROTOCOLS)/unstable/xdg-output/xdg-output-unstable-v1.xml $@
wayland_xdg_output.c:
	$(WAYLAND_SCANNER) private-code $(WAYLAND_PROTOCOLS)/unstable/xdg-output/xdg-output-unstable-v1.xml $@
# The screen saver kit's backdrop: a capture of the screen (wlroots').
wayland_screencopy.h: protocol/wlr-screencopy-unstable-v1.xml
	$(WAYLAND_SCANNER) client-header $< $@
wayland_screencopy.c: protocol/wlr-screencopy-unstable-v1.xml
	$(WAYLAND_SCANNER) private-code $< $@

PYTHON ?= python3
nimbus_%x2.c: fonts/%-Nimbus.bdf fonts/bdf2lvgl.py
	$(PYTHON) fonts/bdf2lvgl.py $< nimbus_$*x2 2 > $@.tmp && mv $@.tmp $@
nimbus_%.c: fonts/%-Nimbus.bdf fonts/bdf2lvgl.py
	$(PYTHON) fonts/bdf2lvgl.py $< nimbus_$* > $@.tmp && mv $@.tmp $@

$(OBJS): lv_conf.h $(PROTO_HDRS)

$(SONAME): $(OBJS)
	$(CC) -shared -Wl,-soname,$(SONAME) $(LDFLAGS) -o $@ $^ $(LDLIBS)

clean:
	rm -f $(SONAME) $(OBJS) $(PROTO_SRCS) $(PROTO_HDRS) $(FONT_SRCS)

.PHONY: all clean
# Keep the generated font sources (make would delete them as intermediates).
.SECONDARY: $(FONT_SRCS)
