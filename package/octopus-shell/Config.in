config BR2_PACKAGE_OCTOPUS_SHELL
	bool "octopus-shell"
	depends on BR2_PACKAGE_OCTOPUS_WM
	select BR2_PACKAGE_LIBOCTOPUS
	help
	  The Chumby One system UI: left-edge app switcher with big
	  volume/brightness buttons that open a touch-sized popup, home
	  screen with the installed apps, knob as volume, night-mode
	  backlight and screen-off hours, snooze button, alarm ringing
	  (octopus-alarm-tone). Starts the octopus-wm session at boot
	  (S95octopus-session).
