config BR2_PACKAGE_LIBOCTOPUS
	bool "liboctopus"
	depends on BR2_TOOLCHAIN_HAS_THREADS # alsa-lib, wayland
	depends on !BR2_STATIC_LIBS # wayland
	select BR2_PACKAGE_LVGL
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_PIXMAN	# the screen saver kit
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_ALSA_LIB_MIXER
	help
	  Common framework for Chumby One apps: LVGL on Wayland, Rockbox's
	  Nimbus bitmap fonts, the universal dark theme with automatic night
	  mode (/etc/octopus/policy.conf), volume/brightness/screen
	  helpers, alarms.
