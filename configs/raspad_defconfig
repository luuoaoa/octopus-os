# RasPad 3: a Raspberry Pi 4B behind a 1280x800 HDMI panel with an ILITEK
# USB touchscreen, running the Chumby UI (chumby-wm, at 3x: see
# board/raspad/README.md). Builds on the Chumby's falconwing-mainline
# userland; board/raspad overrides what differs.
BR2_aarch64=y
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_DL_DIR="$(BR2_EXTERNAL_PIFANSRF_PATH)/dl"
# The Pi kernel's hash (buildroot's) and our fixed-point faad2.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/patches"

# System
BR2_TARGET_GENERIC_HOSTNAME="raspad"
BR2_TARGET_GENERIC_ISSUE="Welcome to raspad (buildroot, Chumby UI)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_INIT_SYSTEMD=y
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing/rootfs-common $(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/rootfs $(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/post-build.sh $(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/post-fakeroot.sh $(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/post-image.sh"

# Kernel: the Raspberry Pi tree buildroot uses for the Pi 4, plus the
# touchscreen (board/raspad/linux.config.fragment).
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/linux.config.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/raspad/cmdline.txt"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# Packages (as the Chumby's, without its FM tuner)
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# The Pi kernel xz-compresses its modules: kmod needs xz to load them.
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_WLROOTS_PIXMAN=y
BR2_PACKAGE_SEATD_BUILTIN=y
BR2_PACKAGE_CHUMBY_WM=y
BR2_PACKAGE_CHUMBY_SHELL=y
BR2_PACKAGE_CHUMBY_APPS=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_JQ=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_FAAD2=y
# Sound through PipeWire (system-wide, WirePlumber): the players' ALSA
# output goes there (asound.conf), into a filter-chain sink that improves
# the small speakers - bankstown's psychoacoustic bass, then a parametric
# EQ - before HDMI (board/raspad/README.md). Not for the Chumby: its
# 454 MHz ARM9 can't spare it.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_LILV=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_BANKSTOWN=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# Root filesystem: ext4 on p2, read-write.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
