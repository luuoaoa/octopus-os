# Chumby One (falconwing) with a mainline kernel.
#
# The stock chumby bootloader and config block (partition 1, extracted by
# board/falconwing/extract-stock.sh) are kept; post-image.sh writes our
# zImage + appended DTB into the krnA slot instead of the 2.6.28 kernel.
BR2_arm=y
BR2_arm926t=y
BR2_DL_DIR="$(BR2_EXTERNAL_PIFANSRF_PATH)/dl"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/patches"

# A current kernel lifts the 2.6.28 constraints: glibc is fine.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV5_EABI_GLIBC_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="chumby"
BR2_TARGET_GENERIC_ISSUE="Welcome to falconwing (buildroot, mainline kernel)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# systemd (its udev also serves libinput, the compositor's input stack).
# Kept lean for 64 MB: no networkd/resolved (wpa_supplicant@wlan0 +
# udhcpc@wlan0 do WiFi), no hwdb, timesyncd for the clock.
BR2_INIT_SYSTEMD=y
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# Time zones: "timezone:" in the config partition's user-data picks one.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing/rootfs-common $(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/post-fakeroot.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/post-image.sh"

# Kernel: latest mainline buildroot knows, mxs_defconfig + board fragment.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_DEFCONFIG="mxs"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/linux.config.fragment"
BR2_LINUX_KERNEL_APPENDED_ZIMAGE=y
# xz: slower to unpack than gzip, but the 4 MiB krnA slot is the hard limit.
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_APPENDED_DTB=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_PIFANSRF_PATH)/board/falconwing-mainline/dts/imx23-chumby-one.dts"

# Packages
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_QN8005=y
# GUI: Wayland. chumby-wm (wlroots, pixman renderer: no GPU) runs
# chumby-shell (left-edge switcher + app list) and the libchumby apps.
BR2_PACKAGE_WLROOTS_PIXMAN=y
BR2_PACKAGE_SEATD_BUILTIN=y
BR2_PACKAGE_CHUMBY_WM=y
BR2_PACKAGE_CHUMBY_SHELL=y
BR2_PACKAGE_CHUMBY_APPS=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# Root filesystem: a squashfs that runs from RAM. post-image.sh puts it on
# the p2 "carrier" ext4 with the early boot (board/falconwing-mainline/
# carrier/sbin/init-ram copies it into a tmpfs) and the persistent /var.
# zstd: close to xz in size, several times faster to unpack on demand.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_64K=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_E2FSPROGS=y

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
