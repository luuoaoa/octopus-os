# Chumby One (falconwing) with a mainline kernel.
#
# The stock Chumby bootloader and config block (partition 1, extracted by
# board/falconwing-mainline/extract-stock.sh) are kept; post-image.sh writes our
# zImage + appended DTB into the krnA slot instead of the 2.6.28 kernel.
BR2_arm=y
BR2_arm926t=y
BR2_DL_DIR="$(BR2_EXTERNAL_OCTOPUS_PATH)/dl"
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/patches"

# A current kernel lifts the 2.6.28 constraints: glibc is fine.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV5_EABI_GLIBC_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="octopus"
BR2_TARGET_GENERIC_ISSUE="Welcome to Octopus OS (Chumby One)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
# systemd (its udev also serves libinput, the compositor's input stack).
# Kept lean for 64 MB: no networkd/resolved (wpa_supplicant@wlan0 +
# udhcpc@wlan0 do WiFi), no hwdb, timesyncd for the clock.
BR2_INIT_SYSTEMD=y
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
BR2_TARGET_GENERIC_GETTY_PORT="ttyAMA0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
# Time zones: "timezone:" in the config partition's user-data picks one.
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/post-fakeroot.sh"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/users.table"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/post-image.sh"

# Kernel: latest mainline buildroot knows, mxs_defconfig + board fragment.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_LATEST_VERSION=y
BR2_LINUX_KERNEL_DEFCONFIG="mxs"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/linux.config.fragment"
BR2_LINUX_KERNEL_APPENDED_ZIMAGE=y
# xz: slower to unpack than gzip, but the 4 MiB krnA slot is the hard limit.
BR2_LINUX_KERNEL_XZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_APPENDED_DTB=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing-mainline/dts/imx23-chumby-one.dts"

# Packages
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
# bin/update-chumby.sh: delta transfers of the system image.
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT2XX=y
BR2_PACKAGE_LINUX_FIRMWARE_RALINK_RT73=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_QN8005=y
# GUI: Wayland. octopus-wm (wlroots, pixman renderer: no GPU) runs
# octopus-shell (left-edge switcher + app list) and the liboctopus apps.
BR2_PACKAGE_WLROOTS_PIXMAN=y
BR2_PACKAGE_SEATD_BUILTIN=y
BR2_PACKAGE_OCTOPUS_WM=y
BR2_PACKAGE_OCTOPUS_SHELL=y
BR2_PACKAGE_OCTOPUS_APPS=y
BR2_PACKAGE_OCTOPUS_BUNDLED_APPS=y
# FM station art: octopus-station-art looks the station up (FCC) and fetches
# its logo (Wikipedia) over HTTPS. libcurl on OpenSSL (below), not mbed
# TLS: OpenSSL's AES/GHASH/ChaCha20 are ARMv4 assembly, mbed TLS's are C,
# and an HTTPS stream's decryption cost the ARM9 ~5% (an HTTP one, none).
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_OPENSSL=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_JQ=y
# AirPlay 1 speaker (the AirPlay app): its own mDNS (tinysvcmdns). With
# OpenSSL: its mbed TLS build signs the Apple-Challenge wrong, and an
# iPhone hangs up after the first request.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SHAIRPORT_SYNC=y
# Internet radio: octopus-stream decodes MP3 with libmpg123, AAC with
# faad2 (its fixed-point build, see board/.../patches/faad2).
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_FAAD2=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# Root filesystem: a read-only squashfs. post-image.sh puts it on the p2
# Profiling on the device: perf (timer sampling; the kernel's
# CONFIG_PERF_EVENTS), elfutils for it to read symbols. bin/chumby-try runs
# unstripped builds in place of the image's for named functions.
BR2_PACKAGE_ELFUTILS=y
BR2_PACKAGE_LINUX_TOOLS=y
BR2_PACKAGE_LINUX_TOOLS_PERF=y

# "carrier" ext4 with the early boot (board/falconwing-mainline/carrier/
# sbin/init-ram loop-mounts it as the root) and the persistent /var.
# zstd: close to xz in size, several times faster to unpack on demand.
BR2_TARGET_ROOTFS_SQUASHFS=y
BR2_TARGET_ROOTFS_SQUASHFS4_ZSTD=y
BR2_TARGET_ROOTFS_SQUASHFS_BS_64K=y
# A tar of the root too: the SDK's simulator image (sdk/make-images.sh).
BR2_TARGET_ROOTFS_TAR=y
BR2_PACKAGE_HOST_E2FSPROGS=y

BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
