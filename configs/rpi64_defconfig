# Any 64-bit Raspberry Pi (3, Zero 2 W, 4, 400, CM4, 5, 500) running the
# Octopus UI, made for the RasPad 3: a Pi 4B behind a 1280x800 HDMI panel
# with an ILITEK USB touchscreen (octopus-wm, at 3x: see
# board/rpi64/README.md). A mouse works too. Builds on the Chumby's
# falconwing userland; board/rpi64 overrides what differs.
BR2_aarch64=y
# Tuned for the Pi 4's A72; the code (ARMv8.0 + CRC) runs on the Pi 3's and
# Zero 2 W's A53 and the Pi 5's A76 alike.
BR2_cortex_a72=y
BR2_ARM_FPU_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
BR2_DL_DIR="$(BR2_EXTERNAL_OCTOPUS_PATH)/dl"
# The Pi kernel's hash (buildroot's) and our fixed-point faad2.
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/patches"

# System
BR2_TARGET_GENERIC_HOSTNAME="octopus"
BR2_TARGET_GENERIC_ISSUE="Welcome to Octopus OS (rpi64)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"
BR2_INIT_SYSTEMD=y
# BR2_PACKAGE_SYSTEMD_HWDB is not set
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# BR2_PACKAGE_SYSTEMD_RESOLVED is not set
# BR2_PACKAGE_SYSTEMD_HOSTNAMED is not set
# BR2_PACKAGE_SYSTEMD_TIMEDATED is not set
# BR2_PACKAGE_SYSTEMD_VCONSOLE is not set
# BR2_PACKAGE_SYSTEMD_PSTORE is not set
# The kernel console (cmdline: serial0 - ttyAMA0, or the Pi 5's).
BR2_TARGET_GENERIC_GETTY_PORT="console"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_TZ_INFO=y
BR2_TARGET_LOCALTIME="Etc/UTC"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing/rootfs $(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/rootfs"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing/post-build.sh $(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/post-build.sh"
BR2_ROOTFS_POST_FAKEROOT_SCRIPT="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/falconwing/post-fakeroot.sh $(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/post-fakeroot.sh"
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/users.table"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/post-image.sh"

# Kernel: the Raspberry Pi tree buildroot uses for the Pi 4, plus the
# touchscreen (board/rpi64/linux.config.fragment).
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/linux.config.fragment"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# Every 64-bit Pi: 3, 3B+, Zero 2 W, CM3, 4, 400, CM4, 5, 500, CM5 (the one
# bcm2711 kernel boots them all; the firmware picks the DTB).
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2710-rpi-3-b broadcom/bcm2710-rpi-3-b-plus broadcom/bcm2710-rpi-zero-2-w broadcom/bcm2710-rpi-zero-2 broadcom/bcm2710-rpi-cm3 broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-400 broadcom/bcm2711-rpi-cm4 broadcom/bcm2711-rpi-cm4s broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-d-rpi-5-b broadcom/bcm2712-rpi-500 broadcom/bcm2712-rpi-cm5-cm5io broadcom/bcm2712-rpi-cm5l-cm5io"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y

# Firmware
BR2_PACKAGE_RPI_FIRMWARE=y
# start.elf (Pi 3, Zero 2 W: with bootcode.bin) and start4.elf (Pi 4); the
# Pi 5 boots from its EEPROM.
BR2_PACKAGE_RPI_FIRMWARE_BOOTCODE_BIN=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI=y
BR2_PACKAGE_RPI_FIRMWARE_VARIANT_PI4=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_OCTOPUS_PATH)/board/rpi64/cmdline.txt"
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y

# Packages (as the Chumby's, without its FM tuner)
BR2_PACKAGE_DROPBEAR=y
# BR2_PACKAGE_DROPBEAR_CLIENT is not set
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WIRELESS_REGDB=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
# The Pi kernel xz-compresses its modules: kmod needs xz to load them.
BR2_PACKAGE_XZ=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
# The GPU renders (wlroots' gles2 renderer on Mesa: v3d on a Pi 4/5, vc4
# on a Zero 2 W/3; no LLVM, no software GL), scaling the 320x240 UI up on
# big screens. pixman stays wlroots' fallback if EGL won't start.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VC4=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_WLROOTS_PIXMAN=y
BR2_PACKAGE_WLROOTS_PIXMAN_GLES2=y
BR2_PACKAGE_SEATD_BUILTIN=y
BR2_PACKAGE_OCTOPUS_WM=y
BR2_PACKAGE_OCTOPUS_SHELL=y
BR2_PACKAGE_OCTOPUS_APPS=y
BR2_PACKAGE_OCTOPUS_BUNDLED_APPS=y
BR2_PACKAGE_MBEDTLS=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_LIBCURL_MBEDTLS=y
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_JQ=y
# AirPlay 1 speaker (the AirPlay app): its own mDNS (tinysvcmdns). With
# OpenSSL: its mbed TLS build signs the Apple-Challenge wrong, and an
# iPhone hangs up after the first request.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_SHAIRPORT_SYNC=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_FAAD2=y
# Sound through PipeWire (system-wide, WirePlumber): the players' ALSA
# output goes there (asound.conf), into a filter-chain sink that improves
# the small speakers - bankstown's psychoacoustic bass, then a parametric
# EQ - before HDMI (board/rpi64/README.md). Not for the Chumby: its
# 454 MHz ARM9 can't spare it.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_LILV=y
BR2_PACKAGE_HOST_RUSTC=y
BR2_PACKAGE_BANKSTOWN=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
# BR2_PACKAGE_ALSA_UTILS_ALSAMIXER is not set
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set

# Root filesystem: ext4 on p2, read-write.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# A tar of the root too: the SDK's simulator image (sdk/make-sdk.sh).
BR2_TARGET_ROOTFS_TAR=y
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_KMOD_XZ=y
BR2_PACKAGE_HOST_MTOOLS=y
